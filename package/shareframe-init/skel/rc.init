#!/bin/sh
# Stage-2: /proc, /sys, /dev are already mounted by /init in the initramfs and
# moved under the new root before switch_root. Just add the FS the initramfs
# didn't set up, then bring up the s6-rc default bundle.

mkdir -p /dev/pts /dev/shm /tmp
mount -t devpts devpts /dev/pts
mount -t tmpfs  tmpfs  /tmp
# RO squashfs root: anything writing /var (dhcpcd, nginx, future pkgs) gets a
# fresh capped tmpfs each boot.
mount -t tmpfs -o mode=0755,size=32m tmpfs /var
mkdir -p /var/db/dhcpcd /var/lib/misc /var/log/nginx /var/spool /var/empty /var/tmp
chmod 1777 /var/tmp

mkdir -p /run/lock /run/log/shareframe /etc/cron/crontabs
ln -sf /run      /var/run
ln -sf /run/lock /var/lock

hostname -F /etc/hostname

s6-rc-init -c /etc/s6-rc/compiled -l /run/s6-rc /run/service
s6-rc -u change default
