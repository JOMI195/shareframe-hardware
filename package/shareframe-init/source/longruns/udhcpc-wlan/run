#!/bin/sh
sleep 1
until [ -e /sys/class/net/wlan0 ]; do sleep 2; done

HOSTNAME="$(sed -n '1p' /etc/hostname 2>/dev/null | tr -d '\r\n')"
if [ -z "$HOSTNAME" ]; then
    HOSTNAME="$(hostname 2>/dev/null | tr -d '\r\n')"
fi

if [ -n "$HOSTNAME" ]; then
    exec udhcpc -f -i wlan0 -x "hostname:$HOSTNAME"
fi

echo "udhcpc-wlan: hostname missing; starting without DHCP hostname" > /dev/console
exec udhcpc -f -i wlan0
