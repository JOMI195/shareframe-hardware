# --- Minimal / headless: nicht benötigte Subsysteme aus ---
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_BCM2835_VCHIQ is not set

# --- Pi Zero W braucht: Serial-Konsole (ttyAMA0) ---
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# --- Root als initramfs (cpio) im RAM ---
CONFIG_BLK_DEV_INITRD=y

# --- Squashfs slot rootfs + tmpfs overlay (mounted by /init in initramfs) ---
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_OVERLAY_FS=y

# --- USB-Gadget-Ethernet (usb0, nur SSH — kein Boot) ---
# configfs statt legacy g_ether/EEM; ECM/RNDIS als Fallback ohne Rebuild.
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
# CONFIG_USB_ETH is not set
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y

# --- RFKILL (wpa_supplicant öffnet /dev/rfkill) ---
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y

CONFIG_LOCALVERSION_AUTO=n
