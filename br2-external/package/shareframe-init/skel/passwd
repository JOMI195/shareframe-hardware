#!/bin/sh
# Real passwd writes tmpfs /etc/shadow; persist root's hash so it survives
# reboots and updates (apply-rootpw re-applies it each boot).
SHADOW="${SHADOW:-/etc/shadow}"
DATA_DIR="${DATA_DIR:-/data/shareframe}"
busybox passwd "$@" || exit $?
h="$(awk -F: '$1=="root"{print $2}' "$SHADOW")"
if [ -n "$h" ] && [ -d "$DATA_DIR" ]; then
	printf '%s\n' "$h" > "$DATA_DIR/rootpw"
	chmod 0600 "$DATA_DIR/rootpw"
fi
exit 0
