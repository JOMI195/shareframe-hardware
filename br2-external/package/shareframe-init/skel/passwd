#!/bin/sh
# Real passwd writes tmpfs /etc/shadow; persist root's hash so it survives
# reboots and updates (apply-rootpw re-applies it each boot).
busybox passwd "$@" || exit $?
h="$(awk -F: '$1=="root"{print $2}' /etc/shadow)"
if [ -n "$h" ] && [ -d /data/shareframe ]; then
	printf '%s\n' "$h" > /data/shareframe/rootpw
	chmod 0600 /data/shareframe/rootpw
fi
exit 0
