#!/bin/sh
# USB only: bind usb0's IPv4 addresses so wlan0 never accepts SSH.
set --
for a in $(ip -4 -o addr show dev usb0 | awk '{sub(/\/.*/, "", $4); print $4}'); do
	set -- "$@" -p "$a:22"
done
[ $# -gt 0 ] || { echo "dropbear: usb0 has no IPv4 address" >&2; sleep 5; exit 1; }
exec dropbear -F -E "$@"
