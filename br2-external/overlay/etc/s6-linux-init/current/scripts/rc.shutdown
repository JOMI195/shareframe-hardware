#!/bin/sh
# Tell self-healing helpers (wifi-stack-restart) to stand down so they don't
# re-up wifi services while s6-rc brings the tree down — otherwise the down
# transition never settles and the board never reaches the final reboot.
/usr/bin/shareframe-led off 2>/dev/null || true
touch /run/shutting-down
s6-rc -bda change 2>/dev/null
# Re-assert: services may have repainted the LED before they died.
/usr/bin/shareframe-led off 2>/dev/null || true
