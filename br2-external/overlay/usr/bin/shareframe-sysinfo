#!/bin/sh
# shareframe-sysinfo — emit board system metrics as `key=value` lines (one per
# line). Board-specific reads (thermal path, iface names, /data mount, busybox
# vs full tools) live HERE in the firmware repo so the C++ dashboard stays
# board-agnostic: it runs this and parses the output. A metric whose source is
# absent is simply omitted — the dashboard treats a missing key as null.
#
# Intentionally no `set -e`: one unavailable source must not drop the rest.

IFACE=wlan0

emit() { printf '%s=%s\n' "$1" "$2"; }

# --- identity / clock ---
emit hostname "$(hostname 2>/dev/null)"
emit kernel "$(uname -sr 2>/dev/null)"
# %z keeps this busybox-safe (GNU -Iseconds isn't always compiled in).
emit time_iso "$(date +%Y-%m-%dT%H:%M:%S%z 2>/dev/null)"

# --- OS identity (subshell so os-release vars don't leak into ours) ---
# shellcheck disable=SC1091  # /etc/os-release is generated at build time
[ -r /etc/os-release ] && ( . /etc/os-release; emit os_pretty_name "${PRETTY_NAME:-}" )

# --- release identity (written by post-build.sh): the semver plus the two repo
# shas it was built from (os = shareframe-hardware, app = shareframe-board) ---
if [ -r /etc/shareframe-release ]; then
	emit version "$(sed -n 's/^VERSION=//p' /etc/shareframe-release)"
	emit os_sha  "$(sed -n 's/^OS_SHA=//p' /etc/shareframe-release)"
	emit app_sha "$(sed -n 's/^APP_SHA=//p' /etc/shareframe-release)"
fi

# --- booted A/B slot (cmdline) + trial flag (staged, uncommitted tryboot) ---
slot=$(sed -n 's/.*rauc\.slot=\([AB]\).*/\1/p' /proc/cmdline 2>/dev/null)
if [ -n "$slot" ]; then
	emit boot_slot "$slot"
	[ "$(cat /data/rauc/pending 2>/dev/null)" = "$slot" ] && emit slot_trial true
fi

# --- hardware identity ---
[ -r /proc/device-tree/model ] && emit host_model "$(tr -d '\0' < /proc/device-tree/model)"
[ -r /proc/cpuinfo ] && emit serial "$(awk '/^Serial/{ print $3; exit }' /proc/cpuinfo)"

# --- uptime (seconds) ---
[ -r /proc/uptime ] && emit uptime_seconds "$(awk '{printf "%d", $1}' /proc/uptime)"

# --- device power-cycle count (persisted across boots by shareframe-boot-count) ---
[ -r /data/shareframe/boot_count ] && emit boot_count "$(cat /data/shareframe/boot_count 2>/dev/null)"

# --- overall health (published by shareframe-health: ok|warn|critical) ---
[ -r /run/shareframe/health ] && emit health_state "$(cat /run/shareframe/health 2>/dev/null)"

# --- per-check health + fault counters (shareframe-health, service-finish, boot-event) ---
HJSON=/run/shareframe/health.json
for c in oom temp disk; do
	s=$(sed -n "s/.*\"$c\":\"\([a-z]*\)\".*/\1/p" "$HJSON" 2>/dev/null)
	[ -n "$s" ] && emit "health_$c" "$s"
done
count() { v=$(cat "$1" 2>/dev/null); case "$v" in ''|*[!0-9]*) v=0 ;; esac; echo "$v"; }
emit crash_count    "$(count /data/shareframe/crash_count)"
emit unclean_resets "$(count /data/shareframe/unclean_resets)"
emit oom_kills      "$(count /run/shareframe/oom-kills)"
emit uv_events      "$(count /run/shareframe/uv_events)"

# --- per-boot watermarks (shareframe-health) ---
[ -r /run/shareframe/temp_peak ] && awk '{ printf "temp_peak_celsius=%.1f\n", $1 / 1000 }' /run/shareframe/temp_peak
[ -r /run/shareframe/ram_avail_min ] && awk '{ printf "ram_available_min_bytes=%.0f\n", $1 * 1024 }' /run/shareframe/ram_avail_min

# --- per app service memory: VmData = heap + thread stacks (musl has no mallinfo) ---
for svc in display dashboard websocket heartbeat update; do
	pid=$(s6-svstat -o pid "/run/service/shareframe-$svc" 2>/dev/null)
	case "$pid" in ''|-*|*[!0-9]*) continue ;; esac
	[ -r "/proc/$pid/status" ] || continue
	awk -v p="proc_${svc}_" '
		/^VmRSS:/   { printf "%srss_bytes=%.0f\n",      p, $2 * 1024 }
		/^VmHWM:/   { printf "%srss_peak_bytes=%.0f\n", p, $2 * 1024 }
		/^VmData:/  { printf "%sheap_bytes=%.0f\n",     p, $2 * 1024 }
		/^VmStk:/   { printf "%sstack_bytes=%.0f\n",    p, $2 * 1024 }
		/^Threads:/ { printf "%sthreads=%d\n",          p, $2 }
	' "/proc/$pid/status"
	emit "proc_${svc}_fds" "$(ls "/proc/$pid/fd" 2>/dev/null | wc -l)"
done

# --- memory (bytes) ---
# %.0f everywhere bytes are printed: busybox awk %d clamps to 32-bit on ARM.
[ -r /proc/meminfo ] && awk '
	/^MemTotal:/     { printf "ram_total_bytes=%.0f\n",     $2 * 1024 }
	/^MemAvailable:/ { printf "ram_available_bytes=%.0f\n", $2 * 1024 }
' /proc/meminfo

# --- storage (bytes) for /data (writable) and / (rootfs) ---
storage() {  # $1=mountpoint  $2=key prefix
	df -k "$1" 2>/dev/null | awk -v p="$2" 'NR==2 {
		printf "%s_total_bytes=%.0f\n", p, $2 * 1024
		printf "%s_free_bytes=%.0f\n",  p, $4 * 1024
	}'
}
storage /data storage_data
storage /     storage_root

# --- CPU temperature (°C); thermal zone may be absent on this kernel ---
TZ_TEMP=/sys/class/thermal/thermal_zone0/temp
[ -r "$TZ_TEMP" ] && awk '{ printf "cpu_temp_celsius=%.1f\n", $1 / 1000 }' "$TZ_TEMP"

# --- CPU frequency (MHz); cpufreq may be absent on this kernel ---
CUR_FREQ=/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq
[ -r "$CUR_FREQ" ] && awk '{ printf "cpu_freq_mhz=%d\n", $1 / 1000 }' "$CUR_FREQ"

# --- load average ---
if [ -r /proc/loadavg ]; then
	read -r l1 l5 l15 _rest < /proc/loadavg
	emit load_1 "$l1"
	emit load_5 "$l5"
	emit load_15 "$l15"
fi

# --- CPU usage % (two /proc/stat samples) ---
if [ -r /proc/stat ]; then
	set -- $(awk '/^cpu /{ print $2,$3,$4,$5,$6,$7,$8; exit }' /proc/stat)
	idle1=$4;  total1=$(( $1 + $2 + $3 + $4 + $5 + $6 + $7 ))
	sleep 0.2 2>/dev/null || sleep 1
	set -- $(awk '/^cpu /{ print $2,$3,$4,$5,$6,$7,$8; exit }' /proc/stat)
	idle2=$4;  total2=$(( $1 + $2 + $3 + $4 + $5 + $6 + $7 ))
	dt=$(( total2 - total1 ));  di=$(( idle2 - idle1 ))
	[ "$dt" -gt 0 ] && emit cpu_usage_percent \
		"$(awk -v dt="$dt" -v di="$di" 'BEGIN { printf "%.1f", (1 - di / dt) * 100 }')"
fi

# --- IPv4 addresses ---
ipv4() {  # $1=iface  $2=key
	addr=$(ip -4 addr show "$1" 2>/dev/null | awk '/[[:space:]]inet /{ print $2; exit }' | cut -d/ -f1)
	[ -n "$addr" ] && emit "$2" "$addr"
}
ipv4 "$IFACE" ip_wlan0
ipv4 usb0     ip_usb0

# --- WLAN mode + SSID (published by wifi-mode-manager) ---
# wifi-mode.json also holds ap_password — only ever read mode/ssid/ap_ssid.
WMODE_FILE=/run/shareframe/wifi-mode
WJSON=/run/shareframe/wifi-mode.json
if [ -r "$WMODE_FILE" ]; then
	wmode=$(cat "$WMODE_FILE")
	emit wifi_mode "$wmode"
	# [{,] anchor: plain "ssid" must not match inside "ap_ssid".
	jget() { sed -n "s/.*[{,]\"$1\":\"\([^\"]*\)\".*/\1/p" "$WJSON" 2>/dev/null; }
	case "$wmode" in
		ap) emit wifi_ssid "$(jget ap_ssid)" ;;
		*)  emit wifi_ssid "$(jget ssid)" ;;
	esac
fi

# --- WLAN signal (dBm) + link state ---
# nl80211 via iw: the kernel has no CFG80211_WEXT, so /proc/net/wireless stays empty.
iw dev "$IFACE" link 2>/dev/null | awk '/signal:/ { printf "wlan_signal_dbm=%d\n", $2; exit }'

OPER="/sys/class/net/${IFACE}/operstate"
if [ -r "$OPER" ]; then
	[ "$(cat "$OPER")" = "up" ] && emit wlan_connected true || emit wlan_connected false
fi

exit 0
