#!/bin/sh
# Diagnostics package for support: sectioned plain text, gzip on stdout (or --out <file>).
# No secrets: wpa/ap.conf/.env/DB/images are never read, credential-looking values are masked.
set -u
LINES="${LINES:-300}"

[ "${1:-}" = "--out" ] && { exec > "${2:?--out needs a file}"; }

section() { printf '\n===== %s =====\n' "$1"; }

collect() {
	section release;        cat /etc/shareframe-release /etc/build-info
	section sysinfo;        shareframe-sysinfo | grep -v '^wifi_ssid='
	section uptime;         uptime; free; df -h
	section services
	for s in /run/service/*; do printf '%s: %s\n' "${s##*/}" "$(s6-svstat "$s" 2>&1)"; done
	section health.json;    cat /run/shareframe/health.json
	section events;         tail -n "$LINES" /data/shareframe/health.log
	section update-history; tail -n 20 /data/shareframe/update-history.jsonl
	section rauc;           rauc status
	section last-reset
	for f in /data/shareframe/last-reset/*; do
		[ -f "$f" ] || continue
		printf -- '--- %s\n' "${f##*/}"; tail -n "$LINES" "$f"
	done
	section dmesg;          dmesg | tail -n "$LINES"
	section syslog;         tail -n "$LINES" /var/log/messages
	for f in /var/log/shareframe/*.log; do
		[ -f "$f" ] || continue
		section "${f##*/}"; tail -n "$LINES" "$f"
	done
}

collect 2>&1 | awk '{
	l = tolower($0)
	if (l ~ /(psk|passw|passphrase|secret|token|private|authorization)[a-z_]*["]?[ ]*[=:]/) sub(/[=:].*/, "=***")
	gsub(/eyJ[A-Za-z0-9_.-]+/, "***")
	print
}' | gzip -c
