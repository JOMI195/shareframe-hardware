#!/bin/sh
# shareframe-wifi — CRUD for wpa_supplicant networks on wlan0.
# Persists across reboots: wpa_supplicant.conf is bind-mounted from
# /data/wifi/ (see bind-persistent-state oneshot).

set -eu

IFACE="${IFACE:-wlan0}"
WPA="wpa_cli -i ${IFACE}"
CONF="${WPA_CONF:-/data/wifi/wpa_supplicant.conf}"

die() { printf 'shareframe-wifi: %s\n' "$*" >&2; exit 1; }

# True when a wpa_supplicant we can talk to is running. In AP fallback mode the
# wifi-mode-manager stops wpa_supplicant (it can't share wlan0 with hostapd), so
# `add` and `del` must fall back to editing the config file directly.
wpa_running() {
	${WPA} ping 2>/dev/null | grep -q PONG
}

wpa_ok() {
	# wpa_cli prints "OK" / "FAIL"; treat anything but OK as failure.
	out="$(${WPA} "$@" 2>&1)" || true
	case "$out" in
		OK*) printf '%s\n' "$out" ;;
		*FAIL*|*"Could not connect"*) die "wpa_cli $* -> $out" ;;
		*) printf '%s\n' "$out" ;;
	esac
}

# Resolve <ssid|id> to numeric network id. Empty result = not found. An SSID
# wins over an id, so a network named "5" is never mistaken for network 5.
find_id() {
	id="$(${WPA} list_networks 2>/dev/null \
		| SSID="$1" awk -F'\t' 'NR>1 && $2==ENVIRON["SSID"] { print $1; exit }')"
	if [ -z "$id" ]; then
		case "$1" in ''|*[!0-9]*) ;; *) id="$1" ;; esac
	fi
	printf '%s\n' "$id"
}

# SSIDs in the config are "quoted" or, for anything not printable ASCII, hex (both
# as wpa_supplicant writes them). The offline paths handle them as hex.
to_hex() { printf '%s' "$1" | od -An -tx1 | tr -d ' \n'; }

# One line per network block, in file order: its SSID as hex.
conf_ssids_hex() {
	awk '/^[[:space:]]*network=[{]/ { inb = 1; v = ""; next }
		inb && /^[[:space:]]*ssid=/ { v = $0; sub(/^[[:space:]]*ssid=/, "", v) }
		inb && /^[[:space:]]*}/ { inb = 0; print v }' "$CONF" 2>/dev/null \
	| while IFS= read -r v; do
		case "$v" in
			\"*\") v="${v#\"}"; to_hex "${v%\"}"; echo ;;
			*) printf '%s\n' "$v" | tr 'A-F' 'a-f' ;;
		esac
	done
}

HEX_AWK='function byte(h, i) { return (index("0123456789abcdef", substr(h, i, 1)) - 1) * 16 + index("0123456789abcdef", substr(h, i + 1, 1)) - 1 }'

# <hex> as wpa_cli prints an SSID (printf_encode): what list shows, del and mod accept.
shown() {
	printf '%s\n' "$1" | awk "$HEX_AWK"'{ for (i = 1; i < length($0); i += 2) { c = byte($0, i)
		if (c == 34) printf "\\\""; else if (c == 92) printf "\\\\"
		else if (c >= 32 && c <= 126) printf "%c", c
		else if (c == 10) printf "\\n"; else if (c == 13) printf "\\r"
		else if (c == 9) printf "\\t"; else if (c == 27) printf "\\e"
		else printf "\\x%02x", c } }'
}

# <hex> as the SSID's own bytes.
raw() { printf '%s\n' "$1" | awk "$HEX_AWK"'{ for (i = 1; i < length($0); i += 2) printf "%c", byte($0, i) }'; }

# The number (from 0) of the first network block for <ssid>, as listed or raw.
conf_block() {
	want="$(to_hex "$1")" n=0
	conf_ssids_hex | while IFS= read -r h; do
		if [ "$h" = "$want" ] || [ "$(shown "$h")" = "$1" ]; then echo "$n"; break; fi
		n=$((n + 1))
	done
}

# rewrite_block <n> drop | psk <hash>: in place, since the conf may be a bind-mount target.
rewrite_block() {
	tmp="$CONF.tmp"
	N="$1" OP="$2" HASH="${3:-}" awk '
		BEGIN { n = ENVIRON["N"]; op = ENVIRON["OP"]; hash = ENVIRON["HASH"] }
		/^[[:space:]]*network=[{]/ { b++; inb = 1; buf = $0 "\n"; next }
		inb {
			mine = (b - 1 == n)
			if (mine && op == "psk" && $0 ~ /^[[:space:]]*(psk|key_mgmt)=/) next
			if (mine && op == "psk" && $0 ~ /^[[:space:]]*}/) buf = buf "\tpsk=" hash "\n"
			buf = buf $0 "\n"
			if ($0 ~ /^[[:space:]]*}/) { inb = 0; if (!(mine && op == "drop")) printf "%s", buf }
			next
		}
		{ print }' "$CONF" > "$tmp" && cat "$tmp" > "$CONF"
	rm -f "$tmp"
}

psk_hash() { # <ssid> <psk>
	hash="$(wpa_passphrase "$1" "$2" 2>/dev/null | awk -F= '/^[[:space:]]*psk=/ { print $2; exit }')"
	[ -n "$hash" ] || die "wpa_passphrase failed for ssid=$1"
	printf '%s\n' "$hash"
}

usage() {
	cat <<'EOF'
Usage: shareframe-wifi <command> [args]

Commands:
  list                      List configured networks
  scan                      Scan + show APs sorted by signal
  add <ssid> [psk]          Add network (open if no psk)
  del <ssid|id>             Remove network
  mod <ssid|id> <psk>       Change PSK on existing network
  status                    Show current association + IP + last ping state
  help                      Show this help
EOF
}

cmd_list() {
	if wpa_running; then
		${WPA} list_networks
		return
	fi
	# Offline (AP mode): synthesize wpa_cli's list_networks layout from the conf
	# so the dashboard still shows saved networks. Header line is dropped by the
	# caller; columns are id<TAB>ssid<TAB>bssid<TAB>flags.
	printf 'network id / ssid / bssid / flags\n'
	i=0
	conf_ssids_hex | while IFS= read -r h; do
		printf '%d\t%s\tany\t\n' "$i" "$(shown "$h")"
		i=$((i + 1))
	done
}

cmd_scan() {
	${WPA} scan >/dev/null
	sleep 2
	# scan_results columns: bssid / freq / signal / flags / ssid
	${WPA} scan_results | awk 'NR==1 { print; next } NR>1' \
		| (read -r hdr; printf '%s\n' "$hdr"; sort -k3,3 -n -r)
}

# Add a network by appending a block straight to the config, used when
# wpa_supplicant is down (AP fallback mode). wpa_supplicant reads the new block
# when the manager brings it back up.
add_offline() {
	ssid="$1"; psk="$2"
	[ -f "$CONF" ] || die "offline add: $CONF missing"
	if [ -z "$psk" ]; then
		auth="key_mgmt=NONE"
	else
		hash="$(psk_hash "$ssid" "$psk")"
		auth="psk=$hash"
	fi
	# Hex, so no SSID can break out of its block.
	printf '\nnetwork={\n\tssid=%s\n\t%s\n}\n' "$(to_hex "$ssid")" "$auth" >> "$CONF"
	printf 'added network (offline) ssid=%s\n' "$ssid"
}

cmd_add() {
	[ $# -ge 1 ] || die "add: need <ssid> [psk]"
	ssid="$1"
	psk="${2:-}"

	# AP fallback: wpa_supplicant is stopped, so write the conf directly.
	if ! wpa_running; then
		add_offline "$ssid" "$psk"
		return 0
	fi

	id="$(${WPA} add_network | tail -1)"
	case "$id" in
		''|*[!0-9]*) die "add_network returned: $id" ;;
	esac

	# ssid must be quoted in wpa_cli set_network.
	wpa_ok set_network "$id" ssid "\"${ssid}\"" >/dev/null

	if [ -z "$psk" ]; then
		wpa_ok set_network "$id" key_mgmt NONE >/dev/null
	else
		# Hashed, so the plaintext PSK never lands in the conf.
		hash="$(psk_hash "$ssid" "$psk")"
		wpa_ok set_network "$id" psk "$hash" >/dev/null
	fi

	wpa_ok enable_network "$id" >/dev/null
	wpa_ok save_config >/dev/null
	printf 'added network id=%s ssid=%s\n' "$id" "$ssid"
}

# Remove the network={} block for <ssid>, used when wpa_supplicant is down (AP fallback mode).
del_offline() {
	[ -f "$CONF" ] || die "offline del: $CONF missing"
	n="$(conf_block "$1")"
	[ -n "$n" ] || die "del: no network matching '$1'"
	rewrite_block "$n" drop
	printf 'removed network (offline) ssid=%s\n' "$1"
}

mod_offline() {
	[ -f "$CONF" ] || die "offline mod: $CONF missing"
	n="$(conf_block "$1")"
	[ -n "$n" ] || die "mod: no network matching '$1'"
	ssid="$(raw "$(conf_ssids_hex | sed -n "$((n + 1))p")")"
	hash="$(psk_hash "$ssid" "$2")"
	rewrite_block "$n" psk "$hash"
	printf 'updated network (offline) ssid=%s\n' "$1"
}

cmd_del() {
	[ $# -ge 1 ] || die "del: need <ssid|id>"
	if ! wpa_running; then
		del_offline "$1"
		return 0
	fi
	id="$(find_id "$1")"
	[ -n "$id" ] || die "del: no network matching '$1'"
	wpa_ok remove_network "$id" >/dev/null
	wpa_ok save_config >/dev/null
	printf 'removed network id=%s\n' "$id"
}

cmd_mod() {
	[ $# -ge 2 ] || die "mod: need <ssid|id> <psk>"
	if ! wpa_running; then
		mod_offline "$1" "$2"
		return 0
	fi
	id="$(find_id "$1")"
	[ -n "$id" ] || die "mod: no network matching '$1'"

	# The current ssid, quoted or hex, is the salt of the hash.
	v="$(${WPA} get_network "$id" ssid)"
	case "$v" in
		\"*\") ssid="${v#\"}"; ssid="${ssid%\"}" ;;
		*) ssid="$(raw "$v")" ;;
	esac
	[ -n "$ssid" ] || die "mod: could not read ssid for id=$id"

	hash="$(psk_hash "$ssid" "$2")"
	wpa_ok set_network "$id" psk "$hash" >/dev/null
	wpa_ok save_config >/dev/null
	printf 'updated network id=%s ssid=%s\n' "$id" "$ssid"
}

cmd_status() {
	${WPA} status || true
	echo "---"
	ip -4 addr show "${IFACE}" 2>/dev/null || echo "no ipv4 on ${IFACE}"
	ip -6 addr show "${IFACE}" scope global 2>/dev/null \
		| awk '/inet6/ { print }' || true
}

[ $# -ge 1 ] || { usage; exit 1; }
sub="$1"; shift
case "$sub" in
	list)   cmd_list "$@" ;;
	scan)   cmd_scan "$@" ;;
	add)    cmd_add  "$@" ;;
	del|delete|rm|remove) cmd_del "$@" ;;
	mod|modify|set)       cmd_mod "$@" ;;
	status) cmd_status "$@" ;;
	help|-h|--help) usage ;;
	*) usage; exit 1 ;;
esac
