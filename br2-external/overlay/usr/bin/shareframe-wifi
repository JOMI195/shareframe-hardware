#!/bin/sh
# shareframe-wifi — CRUD for wpa_supplicant networks on wlan0.
# Persists across reboots: wpa_supplicant.conf is bind-mounted from
# /data/wifi/ (see bind-persistent-state oneshot).

set -eu

IFACE=wlan0
WPA="wpa_cli -i ${IFACE}"
CONF=/data/wifi/wpa_supplicant.conf

die() { printf 'shareframe-wifi: %s\n' "$*" >&2; exit 1; }

# True when a wpa_supplicant we can talk to is running. In AP fallback mode the
# wifi-mode-manager stops wpa_supplicant (it can't share wlan0 with hostapd), so
# `add` and `del` must fall back to editing the config file directly.
wpa_running() {
	${WPA} ping 2>/dev/null | grep -q PONG
}

wpa_ok() {
	# wpa_cli prints "OK" / "FAIL"; treat anything but OK as failure.
	out="$(${WPA} "$@" 2>&1)" || true
	case "$out" in
		OK*) printf '%s\n' "$out" ;;
		*FAIL*|*"Could not connect"*) die "wpa_cli $* -> $out" ;;
		*) printf '%s\n' "$out" ;;
	esac
}

# Resolve <ssid|id> to numeric network id. Empty result = not found.
find_id() {
	target="$1"
	# Numeric: trust it.
	case "$target" in
		''|*[!0-9]*) ;;
		*) printf '%s\n' "$target"; return 0 ;;
	esac
	${WPA} list_networks 2>/dev/null \
		| awk -F'\t' -v ssid="$target" 'NR>1 && $2==ssid { print $1; exit }'
}

usage() {
	cat <<'EOF'
Usage: shareframe-wifi <command> [args]

Commands:
  list                      List configured networks
  scan                      Scan + show APs sorted by signal
  add <ssid> [psk]          Add network (open if no psk)
  del <ssid|id>             Remove network
  mod <ssid|id> <psk>       Change PSK on existing network
  status                    Show current association + IP + last ping state
  help                      Show this help
EOF
}

cmd_list() {
	if wpa_running; then
		${WPA} list_networks
		return
	fi
	# Offline (AP mode): synthesize wpa_cli's list_networks layout from the conf
	# so the dashboard still shows saved networks. Header line is dropped by the
	# caller; columns are id<TAB>ssid<TAB>bssid<TAB>flags.
	printf 'network id / ssid / bssid / flags\n'
	i=0
	grep -o 'ssid="[^"]*"' "$CONF" 2>/dev/null | sed 's/^ssid="//; s/"$//' \
		| while IFS= read -r s; do
			printf '%d\t%s\tany\t\n' "$i" "$s"
			i=$((i + 1))
		done
}

cmd_scan() {
	${WPA} scan >/dev/null
	sleep 2
	# scan_results columns: bssid / freq / signal / flags / ssid
	${WPA} scan_results | awk 'NR==1 { print; next } NR>1' \
		| (read -r hdr; printf '%s\n' "$hdr"; sort -k3,3 -n -r)
}

# Add a network by appending a block straight to the config, used when
# wpa_supplicant is down (AP fallback mode). wpa_supplicant reads the new block
# when the manager brings it back up.
add_offline() {
	ssid="$1"; psk="$2"
	[ -f "$CONF" ] || die "offline add: $CONF missing"

	if [ -z "$psk" ]; then
		{
			printf '\nnetwork={\n'
			printf '\tssid="%s"\n' "$ssid"
			printf '\tkey_mgmt=NONE\n'
			printf '}\n'
		} >> "$CONF"
	else
		# wpa_passphrase emits a full network={} block; drop its plaintext
		# `#psk="..."` comment line so the cleartext never lands in the conf.
		block="$(wpa_passphrase "$ssid" "$psk" 2>/dev/null \
			| grep -v '^[[:space:]]*#psk=')"
		[ -n "$block" ] || die "wpa_passphrase failed for ssid=$ssid"
		printf '\n%s\n' "$block" >> "$CONF"
	fi
	printf 'added network (offline) ssid=%s\n' "$ssid"
}

cmd_add() {
	[ $# -ge 1 ] || die "add: need <ssid> [psk]"
	ssid="$1"
	psk="${2:-}"

	# AP fallback: wpa_supplicant is stopped, so write the conf directly.
	if ! wpa_running; then
		add_offline "$ssid" "$psk"
		return 0
	fi

	id="$(${WPA} add_network | tail -1)"
	case "$id" in
		''|*[!0-9]*) die "add_network returned: $id" ;;
	esac

	# ssid must be quoted in wpa_cli set_network.
	wpa_ok set_network "$id" ssid "\"${ssid}\"" >/dev/null

	if [ -z "$psk" ]; then
		wpa_ok set_network "$id" key_mgmt NONE >/dev/null
	else
		# Hash via wpa_passphrase so plaintext PSK never lands in the conf.
		hash="$(wpa_passphrase "$ssid" "$psk" \
			| awk -F= '/^[[:space:]]*psk=/ { print $2; exit }')"
		[ -n "$hash" ] || die "wpa_passphrase failed for ssid=$ssid"
		wpa_ok set_network "$id" psk "$hash" >/dev/null
	fi

	wpa_ok enable_network "$id" >/dev/null
	wpa_ok save_config >/dev/null
	printf 'added network id=%s ssid=%s\n' "$id" "$ssid"
}

# Remove the network={} block for <ssid> from the config, used when
# wpa_supplicant is down (AP fallback mode). Rewrites in place: the conf may be
# a bind-mount target, which a rename would detach.
del_offline() {
	target="$1"
	[ -f "$CONF" ] || die "offline del: $CONF missing"
	tmp="$CONF.tmp"
	if ! awk -v ssid="$target" '
		/^[[:space:]]*network=[{]/ { inblock = 1; block = $0 "\n"; drop = 0; next }
		inblock {
			block = block $0 "\n"
			line = $0; sub(/^[[:space:]]*/, "", line)
			if (line == "ssid=\"" ssid "\"") drop = 1
			if (line == "}") { inblock = 0; if (drop) removed = 1; else printf "%s", block }
			next
		}
		{ print }
		END { exit removed ? 0 : 1 }
	' "$CONF" > "$tmp"; then
		rm -f "$tmp"
		die "del: no network matching '$target'"
	fi
	cat "$tmp" > "$CONF"
	rm -f "$tmp"
	printf 'removed network (offline) ssid=%s\n' "$target"
}

cmd_del() {
	[ $# -ge 1 ] || die "del: need <ssid|id>"
	if ! wpa_running; then
		del_offline "$1"
		return 0
	fi
	id="$(find_id "$1")"
	[ -n "$id" ] || die "del: no network matching '$1'"
	wpa_ok remove_network "$id" >/dev/null
	wpa_ok save_config >/dev/null
	printf 'removed network id=%s\n' "$id"
}

cmd_mod() {
	[ $# -ge 2 ] || die "mod: need <ssid|id> <psk>"
	id="$(find_id "$1")"
	[ -n "$id" ] || die "mod: no network matching '$1'"
	psk="$2"

	# Pull current ssid (stripped of quotes) so we can hash with it.
	ssid="$(${WPA} get_network "$id" ssid | sed -e 's/^"//' -e 's/"$//')"
	[ -n "$ssid" ] || die "mod: could not read ssid for id=$id"

	hash="$(wpa_passphrase "$ssid" "$psk" \
		| awk -F= '/^[[:space:]]*psk=/ { print $2; exit }')"
	[ -n "$hash" ] || die "wpa_passphrase failed for ssid=$ssid"

	wpa_ok set_network "$id" psk "$hash" >/dev/null
	wpa_ok save_config >/dev/null
	printf 'updated network id=%s ssid=%s\n' "$id" "$ssid"
}

cmd_status() {
	${WPA} status || true
	echo "---"
	ip -4 addr show "${IFACE}" 2>/dev/null || echo "no ipv4 on ${IFACE}"
	ip -6 addr show "${IFACE}" scope global 2>/dev/null \
		| awk '/inet6/ { print }' || true
}

[ $# -ge 1 ] || { usage; exit 1; }
sub="$1"; shift
case "$sub" in
	list)   cmd_list "$@" ;;
	scan)   cmd_scan "$@" ;;
	add)    cmd_add  "$@" ;;
	del|delete|rm|remove) cmd_del "$@" ;;
	mod|modify|set)       cmd_mod "$@" ;;
	status) cmd_status "$@" ;;
	help|-h|--help) usage ;;
	*) usage; exit 1 ;;
esac
