ctrl_interface=/var/run/wpa_supplicant
ctrl_interface_group=0
update_config=1
country=DE

# No networks pre-seeded. On first boot seed-wifi-config copies the factory
# store's wpa_supplicant.conf (p5) to /data/wifi/wpa_supplicant.conf, falling
# back to this template. Add networks at runtime via:
#   shareframe-wifi add <ssid> <psk>
