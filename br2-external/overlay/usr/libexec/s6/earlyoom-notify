#!/bin/sh
# earlyoom-notify — run by earlyoom (-N) on every kill. Funnels earlyoom's
# kills into the same reporting surface as shareframe-health so an OOM event is
# visible in the persisted log, on the LED, and to the dashboard. earlyoom sets
# EARLYOOM_PID / EARLYOOM_NAME / EARLYOOM_UID (name may be empty / contain junk).
set -u

STATE_DIR=/run/shareframe
DATA_DIR=/data/shareframe
LOG_FILE="$DATA_DIR/health.log"

mkdir -p "$STATE_DIR" "$DATA_DIR" 2>/dev/null || true

name=${EARLYOOM_NAME:-?}; pid=${EARLYOOM_PID:-?}; uid=${EARLYOOM_UID:-?}
ts=$(date '+%Y-%m-%dT%H:%M:%S' 2>/dev/null)

printf '%s [oom] earlyoom killed pid=%s name=%s uid=%s\n' "$ts" "$pid" "$name" "$uid" \
	>> "$LOG_FILE" 2>/dev/null || true
logger -t earlyoom "killed pid=$pid name=$name uid=$uid" 2>/dev/null || true

# Bump a counter shareframe-health's check_oom also watches via dmesg; this gives
# an immediate signal even between its poll cycles.
c=0; [ -f "$STATE_DIR/oom-kills" ] && c=$(cat "$STATE_DIR/oom-kills" 2>/dev/null)
printf '%s\n' "$((c + 1))" > "$STATE_DIR/oom-kills" 2>/dev/null || true

shareframe-led error 2>/dev/null || true
exit 0
