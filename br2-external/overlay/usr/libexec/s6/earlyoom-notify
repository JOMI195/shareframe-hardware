#!/bin/sh
# Run by earlyoom (-N) on every kill. Funnels kills into shareframe-health's
# reporting surface (log, LED, dashboard). earlyoom sets EARLYOOM_PID/NAME/UID.
set -u

STATE_DIR=/run/shareframe

mkdir -p "$STATE_DIR" 2>/dev/null || true

name=${EARLYOOM_NAME:-?}; pid=${EARLYOOM_PID:-?}; uid=${EARLYOOM_UID:-?}
shareframe-event oom "earlyoom killed pid=$pid name=$name uid=$uid"

# Bump the OOM counter for an immediate signal between health polls.
c=0; [ -f "$STATE_DIR/oom-kills" ] && c=$(cat "$STATE_DIR/oom-kills" 2>/dev/null)
printf '%s\n' "$((c + 1))" > "$STATE_DIR/oom-kills" 2>/dev/null || true

shareframe-led error 2>/dev/null || true
exit 0
