#!/bin/sh
# s6 finish hook: $1=service $2=exit code (256 = killed) $3=signal.
# Intended stops (wanted down) are silent; restarts and crashes go to the event log.
set -u
svc=$1; code=${2:-0}; sig=${3:-0}
DATA_DIR=/data/shareframe

[ "$(s6-svstat -o wantedup "/run/service/$svc" 2>/dev/null)" = true ] || exit 0

if [ "$code" = 256 ]; then
	case "$sig" in
		1|2|15) shareframe-event service "$svc restarted (signal $sig)"; exit 0 ;;
	esac
	reason="signal $sig"
elif [ "$code" = 0 ]; then
	shareframe-event service "$svc exited cleanly"; exit 0
else
	reason="exit code $code"
fi

shareframe-event crash "$svc $reason"
f=$DATA_DIR/crash_count
n=$(cat "$f" 2>/dev/null || echo 0)
case "$n" in ''|*[!0-9]*) n=0 ;; esac
echo "$((n + 1))" > "$f.tmp" && mv "$f.tmp" "$f"
exit 0
