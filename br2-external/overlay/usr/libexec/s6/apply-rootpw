#!/bin/sh
# /etc/shadow is tmpfs, reset to the squashfs-baked value each boot; re-apply
# the persisted per-device hash so fleet updates can't revert root.
set -e
DEST="${DATA_DIR:-/data/shareframe}/rootpw"
SRC="${FACTORY_DIR:-/run/shareframe/factory}/rootpw"
SHADOW="${SHADOW:-/etc/shadow}"

if [ ! -f "$DEST" ] && [ -s "$SRC" ]; then
	cp "$SRC" "$DEST"
	chmod 0600 "$DEST"
fi
[ -s "$DEST" ] || exit 0

h="$(cat "$DEST")"
awk -F: -v h="$h" 'BEGIN{OFS=":"} $1=="root"{$2=h} {print}' "$SHADOW" > "$SHADOW.new"
chmod 0600 "$SHADOW.new"
mv "$SHADOW.new" "$SHADOW"
