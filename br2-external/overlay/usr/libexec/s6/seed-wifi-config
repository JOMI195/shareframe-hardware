#!/bin/sh
# Seed the wifi config on first boot. Idempotent — never overwrites, so runtime
# edits survive. Source order: staged factory store (p5), then .template.
set -e
DEST=/data/wifi/wpa_supplicant.conf

mkdir -p /data/wifi

if [ -f "$DEST" ]; then
	exit 0
fi

for src in \
	/run/shareframe/factory/wpa_supplicant.conf \
	/usr/share/shareframe/wpa_supplicant.conf.template
do
	if [ -f "$src" ]; then
		cp "$src" "$DEST"
		chmod 0600 "$DEST"
		exit 0
	fi
done

echo "seed-wifi-config: no seed source found; $DEST not created" > /dev/console
exit 0
