#!/bin/sh
# Seed the wifi config on first boot. Idempotent — never overwrites, so runtime
# edits survive. Source order: staged factory store (p5), then .template.
set -e
DEST="${WPA_CONF:-/data/wifi/wpa_supplicant.conf}"
FACTORY="${FACTORY_DIR:-/run/shareframe/factory}"
SHARE="${SHARE_DIR:-/usr/share/shareframe}"
CONSOLE="${CONSOLE:-/dev/console}"

mkdir -p "$(dirname "$DEST")"

if [ -f "$DEST" ]; then
	exit 0
fi

for src in \
	"$FACTORY/wpa_supplicant.conf" \
	"$SHARE/wpa_supplicant.conf.template"
do
	if [ -f "$src" ]; then
		cp "$src" "$DEST"
		chmod 0600 "$DEST"
		exit 0
	fi
done

echo "seed-wifi-config: no seed source found; $DEST not created" > "$CONSOLE"
exit 0
