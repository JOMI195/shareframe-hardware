#!/bin/sh
# Per-device hostname from the Pi serial, so multiple boards coexist on one LAN.
# shellcheck source=br2-external/overlay/usr/lib/shareframe/lib.sh
. "${SF_LIB:-/usr/lib/shareframe/lib.sh}"
[ -n "$(board_serial)" ] || exit 0   # no serial: keep the build-time /etc/hostname fallback
hostname "$(board_name)"
