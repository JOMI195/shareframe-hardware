#!/bin/sh
# Seed the AP-fallback credentials on first boot. Idempotent — never overwrites,
# so a provisioned value survives reboots and A/B switches. Source order: staged
# factory store (p5), per-device derivation from the board serial, .template.
set -e
# shellcheck source=br2-external/overlay/usr/lib/shareframe/lib.sh
. "${SF_LIB:-/usr/lib/shareframe/lib.sh}"
DEST="${AP_CONF:-/data/wifi/ap.conf}"
FACTORY="${FACTORY_DIR:-/run/shareframe/factory}"
SHARE="${SHARE_DIR:-/usr/share/shareframe}"
CONSOLE="${CONSOLE:-/dev/console}"

mkdir -p "$(dirname "$DEST")"
[ -f "$DEST" ] && exit 0

if [ -f "$FACTORY/ap.conf" ]; then
	cp "$FACTORY/ap.conf" "$DEST"
	chmod 0600 "$DEST"
	exit 0
fi

# Per-device: the SSID is the board's name; the WPA2 passphrase derives from the Pi serial.
serial="$(board_serial)"
if [ -n "$serial" ]; then
	# Salt keeps the password from being a bare hash of a public serial.
	pass="$(printf 'shareframe-ap:%s' "$serial" | sha256sum | cut -c1-10)"
	{
		echo "# Per-device AP-fallback credentials (derived from board serial)."
		echo "AP_SSID=$(board_name)"
		echo "AP_PASS=${pass}"
	} > "$DEST"
	chmod 0600 "$DEST"
	exit 0
fi

if [ -f "$SHARE/ap.conf.template" ]; then
	cp "$SHARE/ap.conf.template" "$DEST"
	chmod 0600 "$DEST"
	exit 0
fi

echo "seed-ap-config: no seed source found; $DEST not created" > "$CONSOLE"
exit 0
