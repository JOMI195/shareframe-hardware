#!/bin/sh
# hostapd for the wlan0 AP fallback. Supervised but IDLE until the mode-manager
# creates the ap-enabled flag (self-gating, since s6-rc longruns ignore a `down`
# file) so it never grabs wlan0 before the station services stop. Renders its
# conf from the per-device credentials, then execs hostapd.
set -u
AP_CONF=/data/wifi/ap.conf
RUN_CONF=/run/shareframe/hostapd.conf
FLAG=/run/shareframe/ap-enabled

mkdir -p /run/shareframe
while [ ! -e "$FLAG" ]; do sleep 1; done

AP_SSID=shareframe-board
AP_PASS=
[ -f "$AP_CONF" ] && . "$AP_CONF"

{
	echo "interface=wlan0"
	echo "driver=nl80211"
	echo "ssid=${AP_SSID}"
	echo "country_code=DE"
	echo "ieee80211d=1"
	echo "hw_mode=g"
	echo "channel=6"
	echo "wmm_enabled=1"
	echo "auth_algs=1"
	echo "ignore_broadcast_ssid=0"
	if [ -n "${AP_PASS}" ]; then
		echo "wpa=2"
		echo "wpa_passphrase=${AP_PASS}"
		echo "wpa_key_mgmt=WPA-PSK"
		echo "rsn_pairwise=CCMP"
	fi
} > "$RUN_CONF"

exec hostapd "$RUN_CONF"
