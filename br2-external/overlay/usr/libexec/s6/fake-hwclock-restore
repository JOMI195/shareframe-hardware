#!/bin/sh
# Pi Zero W has no RTC. Restore last-known time so TLS works before NTP sync.
# Sources, in order: /data/fake-hwclock (per-boot save), /etc/fake-hwclock-default (build stamp).
# A power cut without internet still leaves the clock behind by the outage until NTP;
# an offline mode needs a real time source (RTC).
set -e

stamp=
if [ -r /data/fake-hwclock ]; then
	stamp=$(cat /data/fake-hwclock)
elif [ -r /etc/fake-hwclock-default ]; then
	stamp=$(cat /etc/fake-hwclock-default)
fi

case "$stamp" in
	*[!0-9]*|"") exit 0 ;;
esac

date -s "@${stamp}" > /dev/null 2>&1 || true
