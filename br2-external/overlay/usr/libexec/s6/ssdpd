#!/bin/sh
# SSDP announce for router portals and Windows network view. Serve our own
# Basic:1 description.xml (routers ignore ssdpd's hardcoded gateway type).
set -e

mkdir -p /data/ssdpd /run/shareframe/ssdp

# UUID cache on /data so the device isn't duplicated in router UIs each boot.
CACHE=/data/ssdpd/ssdpd.cache
[ -s "$CACHE" ] || echo "uuid:$(cat /proc/sys/kernel/random/uuid)" > "$CACHE"

# Relative presentationURL: resolves to the dashboard whatever IP served it.
cat > /run/shareframe/ssdp/description.xml <<XML
<?xml version="1.0"?>
<root xmlns="urn:schemas-upnp-org:device-1-0">
 <specVersion>
   <major>1</major>
   <minor>0</minor>
 </specVersion>
 <device>
  <deviceType>urn:schemas-upnp-org:device:Basic:1</deviceType>
  <friendlyName>$(hostname)</friendlyName>
  <manufacturer>Shareframe</manufacturer>
  <modelName>Shareframe-Board</modelName>
  <UDN>$(cat "$CACHE")</UDN>
  <presentationURL>/</presentationURL>
 </device>
</root>
XML

exec ssdpd -n -s -r 30 -w -c "$CACHE" -d 'http://%s/ssdp/description.xml' wlan0 usb0
