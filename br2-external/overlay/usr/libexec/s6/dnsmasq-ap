#!/bin/sh
# dnsmasq (DHCP + captive-portal DNS) for the wlan0 AP fallback. Supervised but
# IDLE until AP mode is requested and the gateway IP is up on wlan0 (else the
# bind would fail). Foreground for supervision; lease/pid on tmpfs.
set -u
FLAG=/run/shareframe/ap-enabled

mkdir -p /run/shareframe
while [ ! -e "$FLAG" ]; do sleep 1; done
# Wait for the AP gateway IP so the bind succeeds first try.
until ip -4 addr show wlan0 2>/dev/null | grep -q '192\.168\.4\.1'; do sleep 1; done

exec dnsmasq -k \
	--conf-file=/etc/dnsmasq.d/shareframe-ap.conf \
	--dhcp-leasefile=/run/dnsmasq-ap.leases \
	--pid-file=/run/dnsmasq-ap.pid
