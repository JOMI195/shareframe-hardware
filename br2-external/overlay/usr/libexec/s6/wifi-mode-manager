#!/bin/sh
# Single owner of wlan0: runs it as a station and, when no known network joins
# within a grace window, falls back to hosting the setup access point so the user
# can enter wifi from the dashboard. The two modes are mutually exclusive (the
# chip can't do both). Publishes the current mode for the dashboard backend.
set -u
# shellcheck source=br2-external/overlay/usr/lib/shareframe/lib.sh
. "${SF_LIB:-/usr/lib/shareframe/lib.sh}"

# Paths and timings (overridable for host tests)
IFACE=wlan0
SVC="${SVC:-/run/service}"
STATE_DIR="${STATE_DIR:-/run/shareframe}"
MODE_FILE="$STATE_DIR/wifi-mode"
JSON_FILE="$STATE_DIR/wifi-mode.json"
RETRY_FLAG="$STATE_DIR/wifi-retry-requested"
SWITCH_FLAG="$STATE_DIR/wifi-switching"
LEASED_FLAG="$STATE_DIR/wifi-leased"
AP_CONF="${AP_CONF:-/data/wifi/ap.conf}"
# Exists once the frame has joined a wifi; until then the display keeps its setup screen up.
JOINED_FLAG="${JOINED_FLAG:-/data/shareframe/wifi-joined}"
WPA_CONF="${WPA_CONF:-/data/wifi/wpa_supplicant.conf}"
CONSOLE="${CONSOLE:-/dev/console}"
LOGGER="${LOGGER:-logger}"
STACK_RESTART="${STACK_RESTART:-/usr/libexec/s6/wifi-stack-restart}"

ASSOC_TIMEOUT="${ASSOC_TIMEOUT:-45}"       # T1: wait for *association* before falling back to AP
DHCP_GRACE="${DHCP_GRACE:-70}"             # after assoc on a network that leased since boot: best-effort wait for an IP (no AP fallback)
NO_ADDR_TIMEOUT="${NO_ADDR_TIMEOUT:-300}"  # after assoc with no lease since boot: wait for an IP before falling back to AP
MONITOR_INTERVAL="${MONITOR_INTERVAL:-30}" # connected: ping / association check cadence
AP_POLL="${AP_POLL:-5}"                    # ap: responsiveness to a dashboard retry request
AP_RETRY_EVERY="${AP_RETRY_EVERY:-180}"    # ap: seconds between automatic station retries (>= display min_refresh_secs)
DROP_LIMIT="${DROP_LIMIT:-3}"              # connected: failed assoc checks before re-evaluating
WEDGE_BASE="${WEDGE_BASE:-4}"              # connected: no-internet checks before re-associating
WEDGE_MAX="${WEDGE_MAX:-20}"               # connected: cap on the wedged-link backoff threshold

# Unix time of the last station attempt that fell back to AP; 0 = none since connecting.
LAST_FAILED_AT=0

log() {
	echo "wifi-mode-manager: $*" > "$CONSOLE"
	"$LOGGER" -t wifi-mode-manager "$*" 2>/dev/null || true
}

set_led() { shareframe-led "$1" 2>/dev/null || true; }

ap_creds() {
	AP_SSID=shareframe-board
	AP_PASS=
	# shellcheck source=/dev/null
	[ -f "$AP_CONF" ] && . "$AP_CONF"
}

have_assoc() { wpa_cli -i "$IFACE" status 2>/dev/null | grep -q '^wpa_state=COMPLETED'; }
# A self-assigned link-local address is what dhcpcd takes when no lease comes.
have_ip()    { ip -4 addr show "$IFACE" 2>/dev/null | grep 'inet ' | grep -qv 'inet 169\.254\.'; }
have_internet() { ping -c1 -W1 1.1.1.1 >/dev/null 2>&1; }
cur_ssid() {
	# Strip quotes/backslashes so the value is safe to embed in JSON.
	wpa_cli -i "$IFACE" status 2>/dev/null | sed -n 's/^ssid=//p' | head -1 | tr -d '\\"'
}

# Saved SSIDs as JSON strings; quotes, backslashes and control chars are stripped.
known_ssids() {
	sed -n 's/^[[:space:]]*ssid=//p' "$WPA_CONF" 2>/dev/null \
		| awk '{ gsub(/["\\[:cntrl:]]/, ""); printf "%s\"%s\"", (NR > 1 ? "," : ""), $0 }'
}

# Readers poll these files: write aside and rename so they never see a partial file.
write_mode() {
	mode="$1"
	mkdir -p "$STATE_DIR"
	printf '%s\n' "$mode" > "$MODE_FILE.tmp" && mv -f "$MODE_FILE.tmp" "$MODE_FILE"
	ssid=""; internet=false
	case "$mode" in
		connected) ssid="$(cur_ssid)"; have_internet && internet=true ;;
		connecting) ssid="$(cur_ssid)" ;;
	esac
	known="$(known_ssids)"
	ap_creds
	cat > "$JSON_FILE.tmp" <<EOF
{"mode":"$mode","ssid":"$ssid","internet":$internet,"known_ssids":[$known],"ap_ssid":"$(json_escape "$AP_SSID")","ap_password":"$(json_escape "$AP_PASS")","last_failed_at":$LAST_FAILED_AT}
EOF
	mv -f "$JSON_FILE.tmp" "$JSON_FILE"
}

enter_connecting() {
	log "mode -> connecting"
	# Want the station back: let the finish-script self-heal again.
	rm -f "$SWITCH_FLAG"
	shareframe-ap down 2>/dev/null || true
	s6-svc -u "$SVC/wpa_supplicant" 2>/dev/null || true
	s6-svc -u "$SVC/dhcpcd-wlan"    2>/dev/null || true
	set_led wifi-connecting
	write_mode connecting
}

# Station vs AP: fall back to AP when association fails within the timeout, or when
# the network has handed out no address since boot. Once it has leased, treat as
# connected even if DHCP is pending (no false fallback).
# Returns 0 = connected, 1 = fall back to AP.
wait_for_sta() {
	FALLBACK_REASON="no known wifi joined"
	i=0
	while [ "$i" -lt "$ASSOC_TIMEOUT" ]; do
		have_assoc && break
		sleep 2; i=$((i + 2))
	done
	have_assoc || return 1

	grace=$NO_ADDR_TIMEOUT
	[ -e "$LEASED_FLAG" ] && grace=$DHCP_GRACE
	i=0
	while [ "$i" -lt "$grace" ]; do
		if have_ip; then
			: > "$LEASED_FLAG"
			return 0
		fi
		have_assoc || return 1   # dropped association while waiting -> re-eval
		sleep 2; i=$((i + 2))
	done
	[ -e "$LEASED_FLAG" ] && return 0
	FALLBACK_REASON="no address from $(cur_ssid)"
	return 1
}

enter_connected() {
	log "mode -> connected (ssid=$(cur_ssid))"
	LAST_FAILED_AT=0
	if [ ! -e "$JOINED_FLAG" ]; then
		mkdir -p "$(dirname "$JOINED_FLAG")"
		write_durable "$JOINED_FLAG" "$(date +%s)"
	fi
	shareframe-event wifi "connected"
	set_led normal
	write_mode connected
}

enter_ap() {
	log "mode -> ap ($FALLBACK_REASON)"
	shareframe-event wifi "ap fallback ($FALLBACK_REASON)"
	# Stop + pin down the station services so they don't fight the switch.
	: > "$SWITCH_FLAG"
	s6-svc -d "$SVC/dhcpcd-wlan"    2>/dev/null || true
	s6-svc -d "$SVC/wpa_supplicant" 2>/dev/null || true
	shareframe-ap up
	set_led ap-mode
	write_mode ap
}

# Stay connected; watch association + reachability. Returns when association is
# lost. While associated but unreachable, re-associate with backoff (wedged-link
# recovery; backoff so a genuinely down WAN doesn't flap the link).
monitor_connected() {
	drops=0
	wedge=0
	wedge_limit=$WEDGE_BASE
	while :; do
		sleep "$MONITOR_INTERVAL"
		if ! have_assoc; then
			drops=$((drops + 1))
			log "assoc lost ($drops/$DROP_LIMIT)"
			set_led wifi-connecting
			[ "$drops" -ge "$DROP_LIMIT" ] && return
			continue
		fi
		drops=0
		if have_internet; then
			wedge=0
			wedge_limit=$WEDGE_BASE
			set_led normal
			write_mode connected
		else
			wedge=$((wedge + 1))
			set_led wifi-down
			write_mode connected   # internet=false
			log "associated but no internet ($wedge/$wedge_limit)"
			if [ "$wedge" -ge "$wedge_limit" ]; then
				log "re-associating wifi (wedged link)"
				"$STACK_RESTART" monitor || true
				wedge=0
				wedge_limit=$((wedge_limit * 2))
				[ "$wedge_limit" -gt "$WEDGE_MAX" ] && wedge_limit=$WEDGE_MAX
			fi
		fi
	done
}

# Hold the AP; return when it's time to retry the station.
ap_wait_then_retry() {
	rm -f "$RETRY_FLAG"
	elapsed=0
	while :; do
		sleep "$AP_POLL"
		elapsed=$((elapsed + AP_POLL))
		# Re-publish each tick: AP credentials can change underneath us.
		write_mode ap
		if [ -f "$RETRY_FLAG" ]; then
			rm -f "$RETRY_FLAG"
			log "retry requested by dashboard"
			return
		fi
		if [ "$elapsed" -ge "$AP_RETRY_EVERY" ]; then
			elapsed=0
			case "$(shareframe-ap status 2>/dev/null)" in
				*stations=0) log "periodic station retry"; return ;;
				*) log "client(s) connected; holding AP" ;;
			esac
		fi
	done
}

# State machine
mkdir -p "$STATE_DIR"
while :; do
	enter_connecting
	if wait_for_sta; then
		enter_connected
		monitor_connected
	else
		LAST_FAILED_AT="$(date +%s)"
		enter_ap
		ap_wait_then_retry
	fi
done
