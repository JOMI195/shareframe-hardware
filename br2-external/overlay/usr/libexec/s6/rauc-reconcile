#!/bin/sh
# Boot-time reconcile of a staged A/B update. A pending slot that isn't the
# booted slot means the tryboot attempt failed: mark it bad (never auto-retry)
# and record the rollback for the dashboard.
set -u
BACKEND="${BACKEND:-/usr/lib/rauc/tryboot-backend}"
pending=$(shareframe-slot pending)
[ -n "$pending" ] || exit 0
shareframe-slot trial && exit 0   # tryboot attempt running; mark-good decides
booted=$(shareframe-slot booted)

echo "rauc-reconcile: staged slot $pending never came up (booted $booted); rolling back"
rauc status mark-bad other 2>/dev/null || {
	# rauc unavailable this early would leave pending stuck; clear via backend
	"$BACKEND" set-state "$pending" bad
}
shareframe-update-history rolled-back "staged slot $pending failed to boot"
