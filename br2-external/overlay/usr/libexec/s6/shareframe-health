#!/bin/sh
# shareframe-health — lightweight environmental health daemon. Watches the few
# failure modes nothing else on the board reports, and surfaces them three ways:
# a persisted log on /data (survives reboot), the console/syslog, and a
# dashboard-readable JSON under /run (mirrors wifi-mode-manager's wifi-mode.json).
#
# Deliberately NARROW. It does not police memory or processes — that division of
# labour is intentional:
#   * earlyoom owns out-of-memory: it kills the biggest hog before the kernel
#     OOM-killer locks the board up. This daemon only *reports* OOM events.
#   * s6 owns process supervision: it restarts crashed longruns. This daemon does
#     not second-guess it (no crash-loop policing, no leak-trend guessing).
#
# Scope:
#   oom    kernel OOM-kill or earlyoom kill events  -> report (latched)
#   temp   CPU over-temp + under-voltage/throttle   -> report (no cpufreq control here)
#   disk   low free space / inodes on /data         -> report
#   + overall state -> critical LED + health.json
#
# LED is SHARED with wifi-mode-manager (it owns normal/wifi/ap). To avoid fighting
# it, this daemon only ever asserts `shareframe-led error` on a CRITICAL fault and
# never resets the LED. Probes are best-effort (no `set -e`): a missing source
# must never take the daemon down.
set -u

# --- paths (overridable so the probes are unit-testable on the host) ----------
PROC="${PROC:-/proc}"
THERMAL="${THERMAL:-/sys/class/thermal/thermal_zone0/temp}"
STATE_DIR="${STATE_DIR:-/run/shareframe}"
DATA_DIR="${DATA_DIR:-/data/shareframe}"
LOG_FILE="${LOG_FILE:-$DATA_DIR/health.log}"
DMESG="${DMESG:-dmesg}"

# --- tunables -----------------------------------------------------------------
INTERVAL="${INTERVAL:-30}"           # main loop cadence (seconds)
TEMP_WARN_C="${TEMP_WARN_C:-80}"     # CPU °C -> warn above
TEMP_CRIT_C="${TEMP_CRIT_C:-85}"     #          critical above
DISK_WARN_PCT="${DISK_WARN_PCT:-10}" # free % -> warn below
DISK_CRIT_PCT="${DISK_CRIT_PCT:-5}"  #          critical below
# Only writable filesystems can "fill up". / is read-only squashfs/RAM-root here
# (always ~100% used) — checking it would false-positive.
DISK_MOUNTS="${DISK_MOUNTS:-/data}"
EVENT_HOLD="${EVENT_HOLD:-300}"      # keep a point-in-time event (oom/under-volt) latched this long
LOG_MAX_LINES="${LOG_MAX_LINES:-2000}"

# --- reporting ----------------------------------------------------------------
now() { date '+%Y-%m-%dT%H:%M:%S' 2>/dev/null; }

log() {  # persist + console + best-effort syslog
	printf '%s %s\n' "$(now)" "$*" >> "$LOG_FILE" 2>/dev/null || true
	printf 'shareframe-health: %s\n' "$*" > /dev/console 2>/dev/null || true
	logger -t shareframe-health "$*" 2>/dev/null || true
}

rotate_log() {  # keep the persisted log bounded
	[ -f "$LOG_FILE" ] || return 0
	lines=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
	[ "$lines" -gt "$LOG_MAX_LINES" ] || return 0
	tail -n "$((LOG_MAX_LINES / 2))" "$LOG_FILE" > "$LOG_FILE.tmp" 2>/dev/null &&
		mv "$LOG_FILE.tmp" "$LOG_FILE" 2>/dev/null || true
}

# Emit a log line only when a check changes state (dedup), then remember it.
note_change() {  # $1=check  $2=new-state  $3=detail
	prev_file="$STATE_DIR/state.$1"
	prev=ok; [ -f "$prev_file" ] && prev=$(cat "$prev_file" 2>/dev/null)
	[ "$2" = "$prev" ] || log "[$1] $prev -> $2${3:+ ($3)}"
	printf '%s\n' "$2" > "$prev_file"
}

worse() {  # echo the more severe of two states
	case "$1$2" in
		*critical*) echo critical ;;
		*warn*)     echo warn ;;
		*)          echo ok ;;
	esac
}

publish() {  # $1=overall — write the dashboard-facing surface
	printf '%s\n' "$1" > "$STATE_DIR/health"
	{
		printf '{"overall":"%s"' "$1"
		for c in oom temp disk; do
			s=ok; [ -f "$STATE_DIR/state.$c" ] && s=$(cat "$STATE_DIR/state.$c")
			printf ',"%s":"%s"' "$c" "$s"
		done
		ok=0; [ -f "$STATE_DIR/oom-kills" ] && ok=$(cat "$STATE_DIR/oom-kills")
		printf ',"oom_kills":%s,"updated":"%s"}\n' "${ok:-0}" "$(now)"
	} > "$STATE_DIR/health.json"
}

now_uptime() { cut -d. -f1 "$PROC/uptime" 2>/dev/null || echo 0; }

# Latch a transient event: once seen it reads `active` for EVENT_HOLD seconds, so
# point-in-time failures (OOM kill, under-voltage) stay visible on the dashboard
# and LED instead of vanishing on the next poll. $1=key $2=new-count.
hold_event() {
	hf="$STATE_DIR/event.$1"; nowu=$(now_uptime)
	[ "$2" -gt 0 ] && printf '%s\n' "$nowu" > "$hf"
	last=0; [ -f "$hf" ] && last=$(cat "$hf" 2>/dev/null)
	if [ "$last" -gt 0 ] && [ "$((nowu - last))" -lt "$EVENT_HOLD" ]; then echo active; else echo inactive; fi
}

# Count NEW kernel-ring matches since last poll (dedup via a stored count).
# Handles ring rotation/clear (count drops) without false-firing.
dmesg_new() {  # $1=marker-key  $2=egrep-pattern  -> echoes count of new matches
	mk="$STATE_DIR/dmesg.$1"
	# grep -c already prints 0 (and exits 1) when there are no matches.
	cur=$($DMESG 2>/dev/null | grep -Eic "$2"); cur=${cur:-0}
	prev=0; [ -f "$mk" ] && prev=$(cat "$mk" 2>/dev/null)
	printf '%s\n' "$cur" > "$mk"
	if [ "$cur" -lt "$prev" ]; then echo 0; else echo "$((cur - prev))"; fi
}

# --- probes (each echoes ok|warn|critical) ------------------------------------
check_oom() {
	# Two sources: the kernel OOM-killer (dmesg) and earlyoom's pre-OOM kills
	# (earlyoom logs to syslog, not dmesg, so it reports via the notifier counter).
	n=$(dmesg_new oom 'out of memory|oom-kill|killed process')
	ek=0; [ -f "$STATE_DIR/oom-kills" ] && ek=$(cat "$STATE_DIR/oom-kills" 2>/dev/null)
	pe=0; [ -f "$STATE_DIR/oom-kills.seen" ] && pe=$(cat "$STATE_DIR/oom-kills.seen" 2>/dev/null)
	printf '%s\n' "$ek" > "$STATE_DIR/oom-kills.seen"
	en=0; [ "$ek" -gt "$pe" ] && en=$((ek - pe))
	total=$((n + en))
	if [ "$(hold_event oom "$total")" = active ]; then note_change oom critical "$total new kill(s)"; echo critical
	else note_change oom ok; echo ok; fi
}

check_temp() {
	state=ok; detail=
	if [ -r "$THERMAL" ]; then
		c=$(awk '{ printf "%d", $1/1000 }' "$THERMAL")
		if   [ "$c" -gt "$TEMP_CRIT_C" ]; then state=critical; detail="${c}C"
		elif [ "$c" -gt "$TEMP_WARN_C" ]; then state=warn; detail="${c}C"; fi
	fi
	uv=$(dmesg_new uv 'under-voltage|undervoltage|throttl')
	if [ "$(hold_event uv "$uv")" = active ]; then state=$(worse "$state" critical); detail="${detail:+$detail }under-voltage/throttle"; fi
	note_change temp "$state" "$detail"; echo "$state"
}

check_disk() {
	state=ok; detail=
	for mp in $DISK_MOUNTS; do
		[ -d "$mp" ] || continue
		usedp=$(df -k "$mp" 2>/dev/null | awk 'NR==2{ u=$5; sub(/%/,"",u); print u+0 }')
		iusedp=$(df -i "$mp" 2>/dev/null | awk 'NR==2{ u=$5; sub(/%/,"",u); print u+0 }')
		usedp=${usedp:-0}; iusedp=${iusedp:-0}; freep=$((100 - usedp))
		if [ "$freep" -lt "$DISK_CRIT_PCT" ] || [ "$iusedp" -ge "$((100 - DISK_CRIT_PCT))" ]; then
			state=critical; detail="${detail:+$detail }$mp ${freep}% free"
		elif [ "$freep" -lt "$DISK_WARN_PCT" ] || [ "$iusedp" -ge "$((100 - DISK_WARN_PCT))" ]; then
			state=$(worse "$state" warn); detail="${detail:+$detail }$mp ${freep}% free"
		fi
	done
	note_change disk "$state" "$detail"; echo "$state"
}

# --- main loop ----------------------------------------------------------------
mkdir -p "$STATE_DIR" "$DATA_DIR"
log "[health] daemon up (interval ${INTERVAL}s; oom/temp/disk)"
while :; do
	overall=ok
	for s in "$(check_oom)" "$(check_temp)" "$(check_disk)"; do
		overall=$(worse "$overall" "$s")
	done
	publish "$overall"
	# Only remediation: claim the LED on a critical fault (never reset it —
	# wifi-mode-manager owns the normal/wifi states).
	[ "$overall" = critical ] && shareframe-led error 2>/dev/null || true
	rotate_log
	sleep "$INTERVAL"
done
