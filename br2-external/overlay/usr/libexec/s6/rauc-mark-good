#!/bin/sh
# Commit gate for a staged A/B update. Only when this boot is the tryboot attempt
# (booted == pending): waits for the app + health to look sane, then mark-good
# (commit). If the gate never passes, reboots, which rolls back. Backgrounded.
set -u
PENDING_FILE="${PENDING_FILE:-/data/rauc/pending}"
HEALTH_JSON="${HEALTH_JSON:-/run/shareframe/health.json}"
WIFI_JSON="${WIFI_JSON:-/run/shareframe/wifi-mode.json}"
BACKEND_OK="${BACKEND_OK:-/run/shareframe/backend-ok}"
SCANDIR="${SCANDIR:-/run/service}"
REMOTE_SAFE_MODE="${REMOTE_SAFE_MODE:-/data/shareframe/safe-mode-remote}"
CMDLINE="${CMDLINE:-/proc/cmdline}"
DEADLINE="${DEADLINE:-300}"   # seconds

pending=$(cat "$PENDING_FILE" 2>/dev/null || true)
[ -n "$pending" ] || exit 0
booted=$(sed -n 's/.*rauc\.slot=\([AB]\).*/\1/p' "$CMDLINE")
[ "$pending" = "$booted" ] || exit 0   # rauc-reconcile handles the mismatch

(
	waited=0
	while [ "$waited" -lt "$DEADLINE" ]; do
		ok=1
		# health daemon up and not critical
		grep -q '"overall":"\(ok\|warn\)"' "$HEALTH_JSON" 2>/dev/null || ok=0
		# core app services supervised and up
		for svc in shareframe-display shareframe-dashboard shareframe-update; do
			s6-svstat -o up "$SCANDIR/$svc" 2>/dev/null | grep -q true || ok=0
		done
		# with internet up, the new build must also have reached the backend
		if grep -q '"internet":true' "$WIFI_JSON" 2>/dev/null; then
			[ -f "$BACKEND_OK" ] || ok=0
		fi
		# restore per-device /data files; an unrestorable required one keeps the gate shut
		[ "$ok" = 1 ] && { shareframe-update-verify restore >/dev/null 2>&1 || ok=0; }
		if [ "$ok" = 1 ]; then
			if rauc status mark-good >/dev/null 2>&1; then
				echo "rauc-mark-good: slot $booted committed"
				shareframe-update-history committed
				if [ -f "$REMOTE_SAFE_MODE" ]; then
					rm -f "$REMOTE_SAFE_MODE"
					shareframe-event safe-mode "remote safe mode lifted by committed update"
				fi
			else
				echo "rauc-mark-good: rauc mark-good failed; staying uncommitted"
			fi
			exit 0
		fi
		sleep 5
		waited=$((waited + 5))
	done
	echo "rauc-mark-good: health gate not reached in ${DEADLINE}s; rebooting to roll back"
	shareframe-event update "commit gate not reached in ${DEADLINE}s; rolling back"
	reboot
) &
