#!/bin/sh
# Load the Broadcom wifi driver. brcmfmac sometimes comes up dirty on cold
# boot (firmware load race, SDIO glitch) — retry with rmmod + rfkill unblock
# before giving up. On boards without brcm wifi this still succeeds silently.

WAIT_S=5

wait_wlan0() {
	i=0
	while [ "$i" -lt "$WAIT_S" ]; do
		[ -e /sys/class/net/wlan0 ] && return 0
		sleep 1
		i=$((i + 1))
	done
	return 1
}

# rfkill may have been left "soft blocked" by a previous run. Unblock first so
# the modprobe attempts aren't sabotaged.
for sb in /sys/class/rfkill/rfkill*/soft; do
	[ -e "$sb" ] && echo 0 > "$sb" 2>/dev/null || true
done

modprobe brcmfmac 2>/dev/null || true
wait_wlan0 && exit 0

# Bounce the driver: rmmod, sleep, modprobe again. Helps with firmware races.
echo "load-brcmfmac: wlan0 absent after ${WAIT_S}s; bouncing driver" > /dev/console
rmmod brcmfmac 2>/dev/null || true
rmmod brcmutil 2>/dev/null || true
sleep 1
for sb in /sys/class/rfkill/rfkill*/soft; do
	[ -e "$sb" ] && echo 0 > "$sb" 2>/dev/null || true
done
modprobe brcmfmac 2>/dev/null || true
wait_wlan0 && exit 0

echo "load-brcmfmac: wlan0 still absent after bounce; giving up" > /dev/console
# Don't fail the oneshot — board may legitimately lack brcm wifi.
exit 0
