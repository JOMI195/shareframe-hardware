#!/bin/sh
# Seed /data/shareframe/.env.secrets.toml on first boot. Idempotent — never
# overwrites an existing file so a provisioned per-device value survives reboots
# and A/B slot switches.
#
# Seed sources, in preference order:
#   1. /usr/share/shareframe/.env.secrets.toml.default   (cred-bearing,
#      gitignored, optional — devs drop a pre-provisioned key here)
#   2. /usr/share/shareframe/.env.secrets.toml.template  (tracked credless
#      skeleton with empty values; provisioning fills ed25519_private_key)
#
# Parent dir /data/shareframe is created by shareframe-data-dirs (dependency).
set -e
DEST=/data/shareframe/.env.secrets.toml

if [ -f "$DEST" ]; then
	exit 0
fi

for src in \
	/usr/share/shareframe/.env.secrets.toml.default \
	/usr/share/shareframe/.env.secrets.toml.template
do
	if [ -f "$src" ]; then
		cp "$src" "$DEST"
		chmod 0600 "$DEST"
		exit 0
	fi
done

echo "seed-shareframe-secrets: no seed source found; $DEST not created" > /dev/console
exit 0
