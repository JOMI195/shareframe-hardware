#!/bin/sh
# Seed the secrets file on first boot. Idempotent — never overwrites, so a
# provisioned per-device value survives reboots and A/B switches. Source order:
# .default (provisioned, gitignored) then .template (tracked credless skeleton).
set -e
DEST=/data/shareframe/.env.secrets.toml

if [ -f "$DEST" ]; then
	exit 0
fi

for src in \
	/usr/share/shareframe/.env.secrets.toml.default \
	/usr/share/shareframe/.env.secrets.toml.template
do
	if [ -f "$src" ]; then
		cp "$src" "$DEST"
		chmod 0600 "$DEST"
		exit 0
	fi
done

echo "seed-shareframe-secrets: no seed source found; $DEST not created" > /dev/console
exit 0
