#!/bin/sh
# Seed the secrets file on first boot. Idempotent — never overwrites, so a
# provisioned per-device value survives reboots, A/B switches and updates.
# Source order: staged factory store (p5), then .template (tracked skeleton).
set -e
DEST="${SECRETS:-/data/shareframe/.env.secrets.toml}"
FACTORY="${FACTORY_DIR:-/run/shareframe/factory}"
SHARE="${SHARE_DIR:-/usr/share/shareframe}"
CONSOLE="${CONSOLE:-/dev/console}"

if [ -f "$DEST" ]; then
	exit 0
fi

for src in \
	"$FACTORY/.env.secrets.toml" \
	"$SHARE/.env.secrets.toml.template"
do
	if [ -f "$src" ]; then
		cp "$src" "$DEST"
		chmod 0600 "$DEST"
		exit 0
	fi
done

echo "seed-shareframe-secrets: no seed source found; $DEST not created" > "$CONSOLE"
exit 0
