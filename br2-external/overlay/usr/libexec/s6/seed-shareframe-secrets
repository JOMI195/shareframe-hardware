#!/bin/sh
# Seed the secrets file on first boot. Idempotent — never overwrites, so a
# provisioned per-device value survives reboots, A/B switches and updates.
# Source order: staged factory store (p5), then .template (tracked skeleton).
set -e
DEST=/data/shareframe/.env.secrets.toml

if [ -f "$DEST" ]; then
	exit 0
fi

for src in \
	/run/shareframe/factory/.env.secrets.toml \
	/usr/share/shareframe/.env.secrets.toml.template
do
	if [ -f "$src" ]; then
		cp "$src" "$DEST"
		chmod 0600 "$DEST"
		exit 0
	fi
done

echo "seed-shareframe-secrets: no seed source found; $DEST not created" > /dev/console
exit 0
