#!/bin/sh
# Back up per-device /data files before an A/B update and restore any that a new
# release dropped, gating the commit. RAUC never touches /data; this guards a
# single shared f2fs partition against a buggy new release wiping irreplaceable
# state (device identity, db). The rootfs slot is verity+signature protected, so
# nothing there needs a runtime "still there?" check.
#   backup  (old system, before slot write): copy protected paths to the store
#   restore (new system, in the commit gate): restore any missing one; exit 1 if
#           a REQUIRED path is gone and cannot be restored (blocks mark-good)
# Paths/store are overridable via env (VERIFY_ROOT prefix) for host testing.
set -u

ROOT="${VERIFY_ROOT:-}"
SECRETS="${SECRETS:-$ROOT/data/shareframe/.env.secrets.toml}"
DB_DIR="${DB_DIR:-$ROOT/data/shareframe/db}"
WPA="${WPA:-$ROOT/data/wifi/wpa_supplicant.conf}"
AP="${AP:-$ROOT/data/wifi/ap.conf}"
STORE="${STORE:-$ROOT/data/shareframe/update-verify}"
RELEASE="${RELEASE:-$ROOT/etc/shareframe-release}"
BACKUP="$STORE/backup"

relver() { sed -n 's/^VERSION=//p' "$RELEASE" 2>/dev/null; }
file_present() { [ -s "$1" ]; }                                   # exists, non-empty
dir_present()  { [ -d "$1" ] && [ -n "$(ls -A "$1" 2>/dev/null)" ]; }

do_backup() {
	mkdir -p "$BACKUP"
	for f in "$SECRETS" "$WPA" "$AP"; do
		[ -f "$f" ] || continue
		b="$BACKUP/$(basename "$f")"
		cp "$f" "$b.new" && mv "$b.new" "$b"
	done
	if dir_present "$DB_DIR"; then
		tar -C "$(dirname "$DB_DIR")" -cf "$BACKUP/db.tar.new" "$(basename "$DB_DIR")" \
			&& mv "$BACKUP/db.tar.new" "$BACKUP/db.tar"
	fi
	{
		printf 'from_version=%s\n' "$(relver)"
		printf 'timestamp=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')"
		[ -f "$SECRETS" ] && printf 'secrets_sha256=%s\n' "$(sha256sum "$SECRETS" | cut -d' ' -f1)"
	} > "$STORE/state.new" && mv "$STORE/state.new" "$STORE/state"
	return 0
}

# restore_file <path> -> echoes present|restored|missing
restore_file() {
	path="$1"
	if file_present "$path"; then echo present; return; fi
	src="$BACKUP/$(basename "$path")"
	if [ -f "$src" ]; then
		mkdir -p "$(dirname "$path")"
		if cp "$src" "$path.new" 2>/dev/null && mv "$path.new" "$path"; then
			[ "$path" = "$SECRETS" ] && chmod 0600 "$path" 2>/dev/null
			echo restored; return
		fi
	fi
	echo missing
}

# restore_db -> echoes present|restored|missing
restore_db() {
	if dir_present "$DB_DIR"; then echo present; return; fi
	if [ -f "$BACKUP/db.tar" ]; then
		mkdir -p "$(dirname "$DB_DIR")"
		rm -rf "$DB_DIR"
		if tar -C "$(dirname "$DB_DIR")" -xf "$BACKUP/db.tar" 2>/dev/null; then
			echo restored; return
		fi
	fi
	echo missing
}

do_restore() {
	mkdir -p "$STORE"
	s_sec=$(restore_file "$SECRETS")
	s_db=$(restore_db)
	s_wpa=$(restore_file "$WPA")
	s_ap=$(restore_file "$AP")
	fail=0
	[ "$s_sec" = missing ] && fail=1   # required: device identity
	[ "$s_db" = missing ] && fail=1    # required: tokens/settings/metadata
	to=$(relver)
	from=$(sed -n 's/^from_version=//p' "$STORE/state" 2>/dev/null)
	{
		printf '{"timestamp":"%s","from_version":"%s","to_version":"%s",' \
			"$(date '+%Y-%m-%dT%H:%M:%S')" "${from:-}" "${to:-}"
		printf '"secrets":"%s","db":"%s","wpa_supplicant":"%s","ap":"%s",' \
			"$s_sec" "$s_db" "$s_wpa" "$s_ap"
		printf '"result":"%s"}\n' "$([ "$fail" = 0 ] && echo ok || echo failed)"
	} > "$STORE/last.json.new" && mv "$STORE/last.json.new" "$STORE/last.json"
	return "$fail"
}

case "${1:-}" in
	backup)  do_backup ;;
	restore) do_restore ;;
	*) echo "usage: shareframe-update-verify backup|restore" >&2; exit 2 ;;
esac
