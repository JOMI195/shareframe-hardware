#!/bin/sh
set -eu
LED=/sys/class/leds/ACT
die() { printf 'shareframe-led: %s\n' "$*" >&2; exit 1; }
[ $# -eq 1 ] || die "usage: shareframe-led <state>"
[ -d "$LED" ] || die "ACT LED not found"

case "$1" in
    booting)
        echo heartbeat > "$LED/trigger" ;;
    normal)
        echo mmc0 > "$LED/trigger" ;;
    wifi-connecting)
        echo timer > "$LED/trigger"
        echo 100   > "$LED/delay_on"
        echo 100   > "$LED/delay_off" ;;
    wifi-down)
        echo timer > "$LED/trigger"
        echo 500   > "$LED/delay_on"
        echo 2000  > "$LED/delay_off" ;;
    ap-mode)
        # Distinct from every other state: three quick blinks then a long gap.
        if [ -e "$LED/pattern" ]; then
            echo pattern > "$LED/trigger"
            echo "255 150 0 150 255 150 0 150 255 150 0 1200" > "$LED/pattern"
        else
            # No pattern trigger in this kernel: fall back to a slow even blink.
            echo timer > "$LED/trigger"
            echo 700   > "$LED/delay_on"
            echo 300   > "$LED/delay_off"
        fi ;;
    error)
        echo none > "$LED/trigger"
        echo 1    > "$LED/brightness" ;;
    updating)
        echo timer > "$LED/trigger"
        echo 50    > "$LED/delay_on"
        echo 50    > "$LED/delay_off" ;;
    off)
        echo none > "$LED/trigger"
        echo 0    > "$LED/brightness" ;;
    *) die "unknown state: $1" ;;
esac
