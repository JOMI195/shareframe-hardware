#!/bin/sh
# shareframe-ap — bring the wlan0 AP fallback up/down. Drives the self-gated
# hostapd + dnsmasq-ap services via the /run/shareframe/ap-enabled flag and
# manages the wlan0 gateway IP. The station services (wpa_supplicant /
# dhcpcd-wlan) MUST already be stopped by the caller (wifi-mode-manager):
# brcmfmac cannot share wlan0 between AP and station.
set -u
IFACE=wlan0
AP_IP=192.168.4.1/24
SVC=/run/service
FLAG=/run/shareframe/ap-enabled
AP_CONF=/data/wifi/ap.conf

log() { echo "shareframe-ap: $*" > /dev/console; }

ap_up() {
	log "starting AP on ${IFACE}"
	mkdir -p /run/shareframe
	ip addr flush dev "$IFACE" 2>/dev/null || true
	ip link set "$IFACE" up 2>/dev/null || true
	# Release the gated services, then kick them so they don't wait the poll.
	: > "$FLAG"
	s6-svc -r "$SVC/hostapd" 2>/dev/null || true
	# hostapd needs a moment to switch the radio into AP mode and bring the
	# interface up before we can assign the gateway IP that dnsmasq binds to.
	i=0
	while [ "$i" -lt 10 ]; do
		ip addr add "$AP_IP" dev "$IFACE" 2>/dev/null && break
		sleep 1; i=$((i + 1))
	done
	s6-svc -r "$SVC/dnsmasq-ap" 2>/dev/null || true
}

ap_down() {
	# Flag presence is the source of truth for "AP active". If it's absent the
	# AP isn't running: do nothing and never touch wlan0 (this is called
	# defensively on every switch back to station mode, including normal boot).
	[ -e "$FLAG" ] || return 0
	log "stopping AP on ${IFACE}"
	rm -f "$FLAG"
	# Restart the services so they drop back into their wait loop (flag gone).
	s6-svc -r "$SVC/dnsmasq-ap" 2>/dev/null || true
	s6-svc -r "$SVC/hostapd"    2>/dev/null || true
	ip addr flush dev "$IFACE" 2>/dev/null || true
	ip link set "$IFACE" down  2>/dev/null || true
}

ap_status() {
	if [ -e "$FLAG" ]; then
		stations="$(iw dev "$IFACE" station dump 2>/dev/null | grep -c '^Station')" || stations=0
		echo "up stations=${stations}"
	else
		echo "down stations=0"
	fi
}

# Persist a new AP password to /data/wifi/ap.conf (dashboard "AP-Passwort
# ändern"). Keeps the SSID; survives reboots and A/B updates because
# seed-ap-config never overwrites an existing file.
ap_setpass() {
	pass="$1"
	len="$(printf '%s' "$pass" | wc -c)"
	if [ "$len" -lt 8 ] || [ "$len" -gt 63 ]; then
		echo "setpass: password must be 8-63 bytes" >&2
		exit 1
	fi

	AP_SSID=shareframe-board
	AP_PASS=
	[ -f "$AP_CONF" ] && . "$AP_CONF"

	# The file is shell-sourced (hostapd run script, wifi-mode-manager):
	# single-quote the values, escaping embedded ' as '\''.
	q_ssid="$(printf '%s' "$AP_SSID" | sed "s/'/'\\\\''/g")"
	q_pass="$(printf '%s' "$pass"    | sed "s/'/'\\\\''/g")"

	mkdir -p "$(dirname "$AP_CONF")"
	tmp="${AP_CONF}.tmp"
	{
		echo "AP_SSID='${q_ssid}'"
		echo "AP_PASS='${q_pass}'"
	} > "$tmp"
	chmod 0600 "$tmp"
	mv "$tmp" "$AP_CONF"
	log "AP password updated"

	# Live AP: restart hostapd so it re-renders its config with the new
	# passphrase. Deferred (and detached from the caller's pipes) so the
	# dashboard's HTTP response reaches the AP client before it gets kicked.
	if [ -e "$FLAG" ]; then
		( sleep 2; s6-svc -r "$SVC/hostapd" 2>/dev/null || true ) >/dev/null 2>&1 &
	fi
}

case "${1:-}" in
	up)      ap_up ;;
	down)    ap_down ;;
	status)  ap_status ;;
	setpass) ap_setpass "${2:-}" ;;
	*) echo "usage: shareframe-ap {up|down|status|setpass <password>}" >&2; exit 1 ;;
esac
