#!/bin/sh
# Single-lease DHCP server on usb0: a plugged-in host (laptop or 4B) gets
# 10.55.0.1 automatically and SSH on root@10.55.0.2 just works.

# Wait for usb0 + IP from setup-usb0 oneshot.
until ip -4 -o addr show usb0 2>/dev/null | grep -q '10\.55\.0\.2'; do
	sleep 1
done

touch /run/udhcpd.leases
exec udhcpd -f /etc/udhcpd.conf
