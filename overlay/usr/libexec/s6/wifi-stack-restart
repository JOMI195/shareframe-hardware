#!/bin/sh

SERVICE="$1"
LOCK_DIR=/run/wifi-stack-restart.lock
PID_FILE="$LOCK_DIR/pid"

log() {
    echo "wifi-stack-restart: $*" > /dev/console
}

# Don't fight an intentional shutdown/reboot (see rc.shutdown). Re-upping the
# wifi services here keeps s6-rc's down transition from settling, hanging the
# whole shutdown so the board never reboots.
if [ -e /run/shutting-down ]; then
    exit 0
fi

# Don't fight wifi-mode-manager while it is deliberately switching wlan0 between
# station and AP mode: it stops wpa_supplicant/dhcpcd on purpose, and re-upping
# them here would defeat the AP fallback. The manager clears this flag once it
# wants the station back.
if [ -e /run/shareframe/wifi-switching ]; then
    exit 0
fi

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
        log "already running (triggered by ${SERVICE:-unknown})"
        exit 0
    fi
    rm -rf "$LOCK_DIR"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        log "failed to acquire lock"
        exit 1
    fi
fi

echo $$ > "$PID_FILE"
trap 'rm -rf "$LOCK_DIR"' EXIT

log "restart triggered by ${SERVICE:-unknown}"

if ip link show wlan0 >/dev/null 2>&1; then
    if ! ip addr flush dev wlan0; then
        log "failed to flush addresses on wlan0"
    fi
    if ! ip link set wlan0 down; then
        log "failed to set wlan0 down"
    fi
    if ! ip link set wlan0 up; then
        log "failed to set wlan0 up"
    fi
fi

# s6-svc takes a single service dir; restart each (wpa first — dhcpcd-wlan
# waits on its ctrl socket).
if ! s6-svc -r /run/service/wpa_supplicant; then
    log "failed to restart wpa_supplicant"
    exit 1
fi
s6-svc -r /run/service/dhcpcd-wlan || log "failed to restart dhcpcd-wlan"
