#!/bin/sh
# hostapd for the wlan0 AP fallback. Supervised by s6 but IDLE until
# wifi-mode-manager (via shareframe-ap) requests AP mode by creating
# /run/shareframe/ap-enabled. This self-gating avoids relying on an s6-rc
# `down` file (s6-rc 0.5.5.0 longruns don't honour one) and guarantees hostapd
# never grabs wlan0 until the station services have been stopped.
#
# Renders /run/shareframe/hostapd.conf from the per-device credentials in
# /data/wifi/ap.conf, then execs hostapd in the foreground. On AP teardown the
# manager removes the flag and `s6-svc -r`s this service, dropping us back into
# the wait loop.
set -u
AP_CONF=/data/wifi/ap.conf
RUN_CONF=/run/shareframe/hostapd.conf
FLAG=/run/shareframe/ap-enabled

mkdir -p /run/shareframe
while [ ! -e "$FLAG" ]; do sleep 1; done

AP_SSID=shareframe-board
AP_PASS=
[ -f "$AP_CONF" ] && . "$AP_CONF"

{
	echo "interface=wlan0"
	echo "driver=nl80211"
	echo "ssid=${AP_SSID}"
	echo "country_code=DE"
	echo "ieee80211d=1"
	echo "hw_mode=g"
	echo "channel=6"
	echo "wmm_enabled=1"
	echo "auth_algs=1"
	echo "ignore_broadcast_ssid=0"
	if [ -n "${AP_PASS}" ]; then
		echo "wpa=2"
		echo "wpa_passphrase=${AP_PASS}"
		echo "wpa_key_mgmt=WPA-PSK"
		echo "rsn_pairwise=CCMP"
	fi
} > "$RUN_CONF"

exec hostapd "$RUN_CONF"
