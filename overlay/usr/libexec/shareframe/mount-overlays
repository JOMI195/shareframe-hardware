#!/bin/sh
# Bind persistent state from /data into /etc.
# - dropbear host keys (else `-R` regenerates them every reboot)
# - machine-id (stable across reboots for log correlation)
set -e

mkdir -p /etc/dropbear /data/dropbear
mount --bind /data/dropbear /etc/dropbear

[ -f /etc/machine-id ] || : > /etc/machine-id
[ -f /data/machine-id ] || : > /data/machine-id
mount --bind /data/machine-id /etc/machine-id
