# U-Boot env, single file on the boot FAT. Upstream U-Boot does not support
# CONFIG_SYS_REDUNDAND_ENVIRONMENT with the FAT backend, so no redundant pair.
# mount-boot oneshot mounts /dev/mmcblk0p1 at /boot before fw_setenv is callable.
#
# Device          Offset  Env size
/boot/uboot.env   0x0000  0x4000
