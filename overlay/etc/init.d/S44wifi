#!/bin/sh
# WLAN hochfahren: brcmfmac laden, wpa_supplicant + udhcpc auf wlan0.
IFACE=wlan0
CONF=/etc/wpa_supplicant/wpa_supplicant.conf

case "$1" in
    start)
        printf "Starting wifi: "
        modprobe brcmfmac 2>/dev/null
        # auf Auftauchen von wlan0 warten (SDIO-Probe + Firmware-Load dauert kurz)
        i=0
        while [ $i -lt 15 ] && ! ip link show "$IFACE" >/dev/null 2>&1; do
            sleep 1
            i=$((i+1))
        done
        if ! ip link show "$IFACE" >/dev/null 2>&1; then
            echo "kein $IFACE"
            exit 0
        fi
        ip link set "$IFACE" up 2>/dev/null
        wpa_supplicant -B -i "$IFACE" -c "$CONF" -D nl80211 >/dev/null 2>&1
        udhcpc -i "$IFACE" -b >/dev/null 2>&1
        echo "OK"
        ;;
    stop)
        killall udhcpc wpa_supplicant 2>/dev/null
        ip link set "$IFACE" down 2>/dev/null
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "$0 {start|stop|restart}"
        exit 1
        ;;
esac
