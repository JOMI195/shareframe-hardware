#!/bin/sh

TIMEOUT=15

i=0
while [ $i -lt "$TIMEOUT" ]; do
    ip=$(ip -4 -o addr show usb0 | awk '{print $4}' | cut -d/ -f1)
    if [ -n "$ip" ]; then
        echo "SSH: root@$ip"
        # Signal mit IP für hello Skript in /run
        echo "$ip" > /run/showip.ip
        exit 0
    fi
    sleep 1
    i=$((i+1))
done
echo "SSH: (keine IP)"