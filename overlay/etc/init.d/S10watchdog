#!/bin/sh
KICK=5
TIMEOUT=15

case "$1" in
    start)
        printf "Starting watchdog: "
        watchdog -F -t "$KICK" -T "$TIMEOUT" /dev/watchdog &
        echo $! > /run/watchdog.pid
        echo "OK"
        ;;
    stop)
        printf "Stopping watchdog: "
        if [ -r /run/watchdog.pid ]; then
            kill "$(cat /run/watchdog.pid)" 2>/dev/null
            rm -f /run/watchdog.pid
            echo "OK"
        else
            echo "not running"
        fi
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "$0 not defined"
        exit 1
        ;;
esac
