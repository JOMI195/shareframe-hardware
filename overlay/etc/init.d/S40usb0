#!/bin/sh
# Statische IP auf dem USB-Gadget-Interface (usb0) zum Pi 4B.
# Kein DHCP nötig — Root liegt im RAM, usb0 dient nur SSH/Netz zum 4B.

IFACE=usb0
ADDR=10.55.0.2/24

case "$1" in
    start)
        printf "Configuring %s: " "$IFACE"
        # auf Auftauchen des Gadget-Interface warten (g_ether)
        i=0
        while [ $i -lt 10 ] && ! ip link show "$IFACE" >/dev/null 2>&1; do
            sleep 1
            i=$((i+1))
        done
        ip addr add "$ADDR" dev "$IFACE" 2>/dev/null
        ip link set "$IFACE" up && echo "OK" || echo "FAIL"
        ;;
    stop)
        ip link set "$IFACE" down 2>/dev/null
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "$0 {start|stop|restart}"
        exit 1
        ;;
esac
