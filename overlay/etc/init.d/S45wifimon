#!/bin/sh
# Startet den WiFi-Monitor (wifi-monitor) als Hintergrund-Daemon.
ENABLE=1
DAEMON=/usr/sbin/wifi-monitor
PIDFILE=/run/wifi-monitor.pid

case "$1" in
    start)
        [ "$ENABLE" = "1" ] || { echo "wifi-monitor disabled (ENABLE=0)"; exit 0; }
        printf "Starting wifi-monitor: "
        "$DAEMON" &
        echo $! > "$PIDFILE"
        echo "OK"
        ;;
    stop)
        printf "Stopping wifi-monitor: "
        if [ -r "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null
            rm -f "$PIDFILE"
            echo "OK"
        else
            echo "not running"
        fi
        ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "$0 {start|stop|restart}"
        exit 1
        ;;
esac
