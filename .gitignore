# Build output + caches (buildroot/toolchain checkouts, downloaded tarballs)
artifacts/
build/
br2-external/fragments/kernel-localversion.fragment

# Kernel module build artifacts
br2-external/modules/**/*.o
br2-external/modules/**/*.ko
br2-external/modules/**/*.mod
br2-external/modules/**/*.mod.c
br2-external/modules/**/.*.cmd
br2-external/modules/**/Module.symvers
br2-external/modules/**/modules.order
br2-external/modules/**/.tmp_versions/
br2-external/modules/**/built-in.a

# Only local header include dir for modules + stray CMake host probe
CMakeLists.txt
CMakeFiles/

# Object files
*.o
*.ko
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app

# Debug files
*.dSYM/
*.su

# Lokale Claude-Config — nie ins Studi-sichtbare Template
.claude/

# Python bytecode (ci/check-files.py etc.)
__pycache__/
*.pyc

# Jetbrains
.idea/

# Rust
**/Cargo.lock
**/target/

# Secrets
wpa_supplicant.conf
wpa_supplicant.conf.default
.env.secrets.toml.default

# RAUC dev signing keys (regenerate via scripts/gen-dev-keys.sh)
br2-external/package/shareframe-rauc/files/*.pem
br2-external/package/shareframe-rauc/files/*.srl

# Deploy configs (privat): configs/per-device/<name>/ (Initial-Flash, mit
# Secrets) und configs/fleet/<env>/ (OTA-Updates, nur CA-Cert). Nur die beiden
# example-Templates sind getrackt; die Negation muss UNTER den Secret-Patterns
# oben stehen (spaetere Regel gewinnt), damit example/.../.default re-included wird.
configs/*
!configs/per-device/
configs/per-device/*
!configs/per-device/example/
!configs/per-device/example/**
!configs/fleet/
configs/fleet/*
!configs/fleet/example/
!configs/fleet/example/**

# Per-release hooks (privat). Nur das Beispiel + README sind getrackt; jede
# echte releases/<X.Y.Z>/ bleibt ungetrackt.
releases/*
!releases/example/
!releases/example/**
!releases/README
