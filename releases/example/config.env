# Release config. Copy this dir to releases/<release>/ — the name is arbitrary
# (e.g. launch, hotfix-wifi), NOT the version. Set the version + criticality
# here; it is the single source for both:
#   build   configs/<board> --release <release>   # bakes SHAREFRAME_VERSION
#   release dev|prod --release <release> --from <build-label>
# Uncomment and set the version before using this dir.

#SHAREFRAME_VERSION=1.2.0
SHAREFRAME_CRITICALITY=Minor        # Critical | Important | Minor | Patch
