# Simulator image: QEMU raspi0 with hwsim radios. Built and run by
# tests/system/sim.sh, never flashed. See README.tests.md.
SHAREFRAME_CONFIG_LABEL=sim
SHAREFRAME_BUILD_MODE=dev
SHAREFRAME_PROFILE=sim
SHAREFRAME_EPD=OFF
SHAREFRAME_BOARD_OVERRIDE_SRCDIR="${SHAREFRAME_BOARD_OVERRIDE_SRCDIR:-$(realpath ../shareframe-board)}"
SHAREFRAME_DASHBOARD_FRONTEND_OVERRIDE_SRCDIR="${SHAREFRAME_DASHBOARD_FRONTEND_OVERRIDE_SRCDIR:-$SHAREFRAME_BOARD_OVERRIDE_SRCDIR/dashboard-frontend}"
