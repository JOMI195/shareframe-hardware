# Shareframe per-device dir — pro Kunde/Geraet. KEIN Build-Input mehr:
# Geraete werden aus einem Fleet-Build provisioniert (Sekunden, kein Rebuild):
#   cp -r configs/per-device/example configs/per-device/<geraet>
#   scripts/gen-device-key.sh --device configs/per-device/<geraet>  # Identitaet, Public Key ins Admin
#   $EDITOR configs/per-device/<geraet>/factory/*        # restliche Secrets/WLAN fuellen
#   ./automation.sh build configs/fleet/<env> --release <name>   # einmal pro Release
#   scripts/provision-device.sh --device configs/per-device/<geraet> [--root-passwd]
#   dd if=artifacts/flash/<geraet>-<version>.img of=/dev/sdX bs=4M conv=fsync
#
# factory/ wird in die Factory-Partition (p5) kopiert — der dauerhafte
# Default-Speicher, den ein Factory-Reset wiederherstellt:
#   factory/.env.secrets.toml    (Pflicht: Geraete-Identitaet)
#   factory/wpa_supplicant.conf  (optional: WLAN-Vorbelegung)
#   factory/ap.conf              (optional: AP-Fallback; sonst per Serial abgeleitet)
#   factory/rootpw               (optional: crypt-Hash; --root-passwd erzeugt ihn)
#
# Optionales Label fuer eigene Zwecke; provision-device.sh nutzt den Dir-Namen.
SHAREFRAME_CONFIG_LABEL=example
