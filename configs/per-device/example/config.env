# Shareframe deploy config — pro Kunde/Geraet.
# Wird von automation.sh ge-source't (set -a, alle Werte werden exportiert).
# Kopiere diesen Ordner: cp -r configs/example configs/<kunde>, fuelle die Werte,
# lege echte Secrets/WLAN in overlay/ ab, dann: ./automation.sh build configs/<kunde>

# Runtime-Signal: dev | prod. prod = udhcpd-usb0 etc. aktiv.
SHAREFRAME_BUILD_MODE=prod

# App-Config-Overlay: dev | prod | prod.local. Waehlt config.<profile>.toml.
SHAREFRAME_PROFILE=prod

# e-Paper-Hardware: ON | OFF. ON linkt den waveshare-EPD-Treiber (SPI/GPIO).
# Beim Umschalten des Wertes vorher 'make -C build/buildroot shareframe-board-dirclean'
# (CMake cached die Option).
SHAREFRAME_EPD=OFF

# Optionales Label, landet in /etc/build-info (config_label=...).
SHAREFRAME_CONFIG_LABEL=example

# Root-Passwort: im rootfs gebacken, jedes Update ueberschreibt es; leer = Buildroot-Default ("root").
#SHAREFRAME_ROOT_PASSWD=root

# Optional: externe Projekte aus lokalem Checkout bauen statt aus dem
# Default-Geschwisterpfad (../shareframe-board). Absolut oder relativ zu
# build/buildroot (in-tree-Build). Auskommentiert = Default-Pfad.
#SHAREFRAME_BOARD_OVERRIDE_SRCDIR=/abs/pfad/zu/shareframe-board
#SHAREFRAME_DASHBOARD_FRONTEND_OVERRIDE_SRCDIR=/abs/pfad/zu/shareframe-board/dashboard-frontend
