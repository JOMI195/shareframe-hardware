# Shareframe FLEET config — fuer OTA-Updates an eine ganze Gruppe.
# Baut ein CREDLESS rootfs: nur der fleet-weite RAUC-Trust-Anchor (ca.cert.pem),
# KEINE Geraete-Secrets. NIE eine per-device config fuer Updates bauen — sonst
# landen Geraete-/Kunden-Secrets (.env, WLAN, AP) im Bundle und gehen an alle.
#   cp -r configs/fleet/example configs/fleet/<env>
#   CA-Cert nach overlay/etc/rauc/ca.cert.pem legen (siehe overlay/etc/rauc/README)
#   ./automation.sh build configs/fleet/<env> --release <name>

# Runtime-Signal: dev | prod.
SHAREFRAME_BUILD_MODE=prod

# App-Config-Overlay: dev | prod | prod.local. Waehlt config.<profile>.toml.
SHAREFRAME_PROFILE=prod

# e-Paper-Hardware: ON | OFF.
SHAREFRAME_EPD=OFF

# Label -> /etc/build-info + Build-Ordnername (<label>-<version>). Leer = Ordnername.
#SHAREFRAME_CONFIG_LABEL=

# Root-Passwort: rootfs-gebacken, fleet-weit; JEDES Update setzt es — konsistent setzen, sonst Reset auf Buildroot-Default ("root").
#SHAREFRAME_ROOT_PASSWD=
